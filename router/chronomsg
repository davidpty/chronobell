#!/bin/sh

BASE="${CHRONOMSG_BASE:-/etc/chronomsg}"
MSG_DIR="${CHRONOMSG_MSG_DIR:-$BASE/messages.d}"
OUT="${CHRONOMSG_OUT:-$BASE/messages.json}"
STATE_FILE="${CHRONOMSG_STATE_FILE:-$BASE/domain-state}"
LOCK_FILE="${CHRONOMSG_LOCK_FILE:-$BASE/check-domain.lock}"
LOG_FILE="${CHRONOMSG_LOG_FILE:-$BASE/chronomsg.log}"
CRON_FILE="${CHRONOMSG_CRON_FILE:-/etc/crontabs/root}"
GQR_STATE="${CHRONOMSG_GQR_STATE:-$BASE/guestqr-state}"
GQR_SSID="${CHRONOMSG_GQR_SSID:-NEXO-GUEST}"
GQR_SECTION="${CHRONOMSG_GQR_SECTION:-guest2g}"
GQR_LENGTH="${CHRONOMSG_GQR_LENGTH:-12}"
GQR_ALPHABET="${CHRONOMSG_GQR_ALPHABET:-ABCDEFGHJKLNPQRTUVXYZ}"
GQR_OUTDIR="${CHRONOMSG_GQR_OUTDIR:-/www/qr}"
DISMISSED_FILE="${CHRONOMSG_DISMISSED_FILE:-$BASE/dismissed}"
LOCK_STALE_SEC=900

ensure_base() {
    mkdir -p "$BASE" "$MSG_DIR"
}

log_msg() {
    ensure_base
    msg="$*"
    logger -t chronomsg "$msg" 2>/dev/null || true
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || date +%s)" "$msg" >> "$LOG_FILE" 2>/dev/null || true
}

now_epoch() {
    date +%s 2>/dev/null || printf '0\n'
}

safe_text() {
    printf '%s' "$1" | sed 's/[^A-Za-z0-9 ._\/:-]/ /g; s/[ ][ ]*/ /g; s/^ //; s/ $//'
}

safe_id() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9._-]/-/g; s/--*/-/g; s/^-//; s/-$//'
}

domain_suffix() {
    domain="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
    first="${domain%%.*}"
    safe_id "${first:-$domain}"
}

json_escape() {
    safe_text "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

bool_value() {
    case "${1:-false}" in
        1|true|TRUE|yes|YES|on|ON) printf true ;;
        *) printf false ;;
    esac
}

num_value() {
    case "${1:-}" in
        ''|*[!0-9]*) printf '%s' "$2" ;;
        *) printf '%s' "$1" ;;
    esac
}

message_file_for_id() {
    printf '%s/%s.json' "$MSG_DIR" "$(safe_id "$1")"
}

write_empty_payload() {
    now="$(now_epoch)"
    printf '{"device":"chronobell","now":%s,"messages":[]}\n' "$now" > "$OUT"
}

is_dismissed() {
    grep -Fqx "$1" "$DISMISSED_FILE" 2>/dev/null
}

extract_num_field() {
    sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$1" | sed -n '1p'
}

is_message_valid() {
    f="$1"
    grep -q '"id"[[:space:]]*:' "$f" 2>/dev/null || return 1
    grep -q '"display"[[:space:]]*:' "$f" 2>/dev/null || return 1
    grep -q '"created"[[:space:]]*:' "$f" 2>/dev/null || return 1
    grep -q '"expires"[[:space:]]*:' "$f" 2>/dev/null || return 1
    grep -q '"title"[[:space:]]*:' "$f" 2>/dev/null || grep -q '"body"[[:space:]]*:' "$f" 2>/dev/null || return 1
    case "$(cat "$f" 2>/dev/null)" in
        \{*\}) return 0 ;;
        *) return 1 ;;
    esac
}

rebuild_payload() {
    ensure_base
    now="$(now_epoch)"
    tmp="$OUT.$$"
    printf '{"device":"chronobell","now":%s,"messages":[' "$now" > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    first=1
    for f in "$MSG_DIR"/*.json; do
        [ -f "$f" ] || continue
        exp="$(extract_num_field "$f" expires)"
        if [ -n "$exp" ] && [ "$exp" -le "$now" ]; then
            rm -f "$f"
            continue
        fi
        if ! is_message_valid "$f"; then
            log_msg "skipping malformed message file $f"
            continue
        fi
        id="$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
        if [ -n "$id" ] && is_dismissed "$id"; then
            continue
        fi
        [ "$first" -eq 0 ] && printf ',' >> "$tmp"
        cat "$f" >> "$tmp"
        first=0
    done
    printf ']}\n' >> "$tmp"
    mv "$tmp" "$OUT"

    if [ -f "$DISMISSED_FILE" ]; then
        active_ids=""
        for f in "$MSG_DIR"/*.json; do
            [ -f "$f" ] || continue
            id="$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
            [ -n "$id" ] && active_ids="$active_ids
$id"
        done
        tmp_d="$BASE/dismissed.$$"
        : > "$tmp_d"
        while IFS= read -r d; do
            [ -z "$d" ] && continue
            printf '%s\n' "$active_ids" | grep -Fqx "$d" && printf '%s\n' "$d" >> "$tmp_d"
        done < "$DISMISSED_FILE"
        mv "$tmp_d" "$DISMISSED_FILE"
    fi
}

serve_payload() {
    cgi="${1:-false}"
    ensure_base
    if [ "$cgi" = true ]; then
        dismiss_id=""
        case "$QUERY_STRING" in
            *dismiss=*) dismiss_id="$(printf '%s' "$QUERY_STRING" | sed 's/.*dismiss=//; s/&.*//')" ;;
        esac
        if [ -n "$dismiss_id" ]; then
            dismiss_id="$(safe_id "$dismiss_id")"
            if [ -n "$dismiss_id" ] && ! is_dismissed "$dismiss_id"; then
                printf '%s\n' "$dismiss_id" >> "$DISMISSED_FILE"
                log_msg "dismissed via cgi id=$dismiss_id"
            fi
        fi
    fi
    rebuild_payload >/dev/null 2>&1 || {
        write_empty_payload
    }
    if [ "$cgi" = true ]; then
        printf 'Content-Type: application/json\r\n'
        printf 'Cache-Control: no-store\r\n'
        printf '\r\n'
    fi
    if [ -f "$OUT" ]; then
        cat "$OUT"
    else
        now="$(now_epoch)"
        printf '{"device":"chronobell","now":%s,"messages":[]}\n' "$now"
    fi
}

add_message() {
    id=""
    source="manual"
    type="alert"
    priority=5
    title=""
    body=""
    detail=""
    ttl=3600
    repeat=false
    duration=6
    interval=""
    indicator=true
    dismissible=true

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --id) id="${2:-}"; shift 2 ;;
            --source) source="${2:-}"; shift 2 ;;
            --type) type="${2:-}"; shift 2 ;;
            --priority) priority="${2:-}"; shift 2 ;;
            --title) title="${2:-}"; shift 2 ;;
            --body) body="${2:-}"; shift 2 ;;
            --detail) detail="${2:-}"; shift 2 ;;
            --ttl) ttl="${2:-}"; shift 2 ;;
            --repeat) repeat="${2:-}"; shift 2 ;;
            --duration) duration="${2:-}"; shift 2 ;;
            --interval) interval="${2:-}"; shift 2 ;;
            --indicator) indicator="${2:-}"; shift 2 ;;
            --dismissible) dismissible="${2:-}"; shift 2 ;;
            --*) printf 'Unknown option: %s\n' "$1" >&2; return 2 ;;
            *)
                if [ -z "$title" ]; then
                    title="$1"
                elif [ -z "$body" ]; then
                    body="$1"
                else
                    body="$body $1"
                fi
                shift
                ;;
        esac
    done

    [ -n "$title$body" ] || {
        printf 'title or body required\n' >&2
        return 2
    }

    priority="$(num_value "$priority" 5)"
    ttl="$(num_value "$ttl" 3600)"
    duration="$(num_value "$duration" 6)"
    if [ -n "$interval" ]; then
        interval="$(num_value "$interval" 0)"
    fi

    now="$(now_epoch)"
    expires=$((now + ttl))
    if [ -z "$id" ]; then
        slug="$(safe_id "$(printf '%s-%s' "$title" "$now")")"
        id="${slug:-chronomsg-$now}"
    fi
    id="$(safe_id "$id")"
    [ -n "$id" ] || {
        printf 'invalid id\n' >&2
        return 2
    }

    ensure_base
    file="$(message_file_for_id "$id")"
    tmp="$file.$$"
    {
        printf '{'
        printf '"id":"%s",' "$(json_escape "$id")"
        printf '"source":"%s",' "$(json_escape "$source")"
        printf '"type":"%s",' "$(json_escape "$type")"
        printf '"priority":%s,' "$priority"
        printf '"title":"%s",' "$(json_escape "$title")"
        printf '"body":"%s",' "$(json_escape "$body")"
        [ -n "$detail" ] && printf '"detail":"%s",' "$(json_escape "$detail")"
        printf '"created":%s,' "$now"
        printf '"expires":%s,' "$expires"
        printf '"display":{'
        printf '"repeat":%s,' "$(bool_value "$repeat")"
        printf '"duration":%s,' "$duration"
        [ -n "$interval" ] && printf '"interval":%s,' "$interval"
        printf '"indicator":%s,' "$(bool_value "$indicator")"
        printf '"dismissible":%s' "$(bool_value "$dismissible")"
        printf '}}'
    } > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    mv "$tmp" "$file"
    log_msg "message created id=$id"
    rebuild_payload
}

clear_message() {
    if [ "$1" = --all ]; then
        ensure_base
        rm -f "$MSG_DIR"/*.json
        rebuild_payload
        printf 'all messages cleared\n'
        return 0
    fi
    [ "$#" -eq 1 ] || {
        printf 'Usage: chronomsg clear <id>  or  chronomsg clear --all\n' >&2
        return 2
    }
    ensure_base
    id="$(safe_id "$1")"
    rm -f "$(message_file_for_id "$id")"
    rebuild_payload
}

dismiss_message() {
    id="${1:-}"
    [ -z "$id" ] && { printf 'Usage: chronomsg dismiss <id>\n' >&2; return 2; }
    ensure_base
    id="$(safe_id "$id")"
    [ -z "$id" ] && { printf 'Invalid id\n' >&2; return 2; }
    if is_dismissed "$id"; then
        printf 'already dismissed: %s\n' "$id"
        return 0
    fi
    printf '%s\n' "$id" >> "$DISMISSED_FILE"
    rebuild_payload
    printf 'dismissed: %s\n' "$id"
}

undismiss_message() {
    id="${1:-}"
    [ -z "$id" ] && { printf 'Usage: chronomsg undismiss <id>\n' >&2; return 2; }
    ensure_base
    id="$(safe_id "$id")"
    [ -z "$id" ] && { printf 'Invalid id\n' >&2; return 2; }
    tmp="$BASE/undismiss.$$"
    grep -Fxv "$id" "$DISMISSED_FILE" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$DISMISSED_FILE"
    rebuild_payload
    printf 'undismissed: %s\n' "$id"
}

list_dismissed() {
    if [ -f "$DISMISSED_FILE" ] && [ -s "$DISMISSED_FILE" ]; then
        while IFS= read -r id; do
            [ -n "$id" ] && printf '%s\n' "$id"
        done < "$DISMISSED_FILE"
    else
        printf 'no dismissed messages\n'
    fi
}

list_messages() {
    rebuild_payload >/dev/null 2>&1 || true
    ensure_base
    found=0
    for f in "$MSG_DIR"/*.json; do
        [ -f "$f" ] || continue
        found=1
        id="$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
        title="$(sed -n 's/.*"title"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
        body="$(sed -n 's/.*"body"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
        exp="$(extract_num_field "$f" expires)"
        name="${f##*/}"
        name="${name%.json}"
        printf '%s priority=%s expires=%s title="%s" body="%s"\n' \
            "${id:-$name}" \
            "$(extract_num_field "$f" priority)" \
            "${exp:-unknown}" "$title" "$body"
    done
    [ "$found" -eq 1 ] || printf 'no active messages\n'
}

read_state() {
    if [ -f "$STATE_FILE" ]; then
        sed -n '1p' "$STATE_FILE"
    else
        printf 'UNKNOWN\n'
    fi
}

write_state() {
    ensure_base
    printf '%s\n' "$1" > "$STATE_FILE"
}

lock_age() {
    now="$(now_epoch)"
    ts="$(sed -n '1p' "$LOCK_FILE" 2>/dev/null)"
    case "$ts" in
        ''|*[!0-9]*) printf '%s\n' "$LOCK_STALE_SEC" ;;
        *) printf '%s\n' $((now - ts)) ;;
    esac
}

acquire_lock() {
    ensure_base
    if [ -f "$LOCK_FILE" ]; then
        age="$(lock_age)"
        if [ "$age" -lt "$LOCK_STALE_SEC" ]; then
            log_msg "domain check skipped fresh lock age=${age}s"
            return 1
        fi
        log_msg "removing stale domain check lock age=${age}s"
        rm -f "$LOCK_FILE"
    fi
    now_epoch > "$LOCK_FILE"
    return 0
}

release_lock() {
    rm -f "$LOCK_FILE"
}

have_cmd() {
    command -v "$1" >/dev/null 2>&1
}

fetch_rdap_curl() {
    domain="$1"
    url="$2"
    body="$3"
    code_file="$4"
    code="$(curl -L -sS -m 12 -o "$body" -w '%{http_code}' "$url" 2>/dev/null)"
    rc=$?
    printf '%s\n' "${code:-000}" > "$code_file"
    return "$rc"
}

fetch_rdap_wget() {
    domain="$1"
    url="$2"
    body="$3"
    code_file="$4"
    hdr="$body.hdr"
    rm -f "$hdr"
    wget -T 12 -q -S -O "$body" "$url" 2>"$hdr"
    rc=$?
    code="$(sed -n 's/.*HTTP\/[^ ]*[ ]*\([0-9][0-9][0-9]\).*/\1/p' "$hdr" | sed -n '$p')"
    [ -n "$code" ] || code=000
    printf '%s\n' "$code" > "$code_file"
    rm -f "$hdr"
    return "$rc"
}

rdap_url_for_domain() {
    domain="$1"
    tld="${domain##*.}"
    case "$tld" in
        com) printf 'https://rdap.verisign.com/com/v1/domain/%s\n' "$domain" ;;
        net) printf 'https://rdap.verisign.com/net/v1/domain/%s\n' "$domain" ;;
        *) printf 'https://rdap.org/domain/%s\n' "$domain" ;;
    esac
}

interpret_rdap() {
    body="$1"
    code="$2"
    if [ "$code" = 404 ]; then
        if grep -qi '"errorCode"' "$body" 2>/dev/null; then
            printf 'AVAILABLE\n'
            return
        fi
        printf 'AMBIGUOUS\n'
        return
    fi
    if [ "$code" = 200 ]; then
        if grep -qi '"ldhName"[[:space:]]*:' "$body" 2>/dev/null || grep -qi '"objectClassName"[[:space:]]*:[[:space:]]*"domain"' "$body" 2>/dev/null; then
            printf 'REGISTERED\n'
            return
        fi
        if grep -qi 'not found\|no match' "$body" 2>/dev/null; then
            printf 'AVAILABLE\n'
            return
        fi
        printf 'AMBIGUOUS\n'
        return
    fi
    case "$code" in
        000) printf 'ERROR\n' ;;
        *) printf 'AMBIGUOUS\n' ;;
    esac
}

check_rdap() {
    domain="$1"
    body="$BASE/rdap.$$"
    code_file="$BASE/rdap-code.$$"
    url="$(rdap_url_for_domain "$domain")"
    rm -f "$body" "$code_file"
    if have_cmd curl; then
        if fetch_rdap_curl "$domain" "$url" "$body" "$code_file"; then
            code="$(sed -n '1p' "$code_file")"
            state="$(interpret_rdap "$body" "$code")"
            printf 'RDAP %s\n' "$state"
            rm -f "$body" "$code_file"
            return 0
        fi
    fi
    if have_cmd wget; then
        fetch_rdap_wget "$domain" "$url" "$body" "$code_file"
        code="$(sed -n '1p' "$code_file")"
        if [ "$code" != 000 ] || [ -s "$body" ]; then
            state="$(interpret_rdap "$body" "$code")"
            printf 'RDAP %s\n' "$state"
            rm -f "$body" "$code_file"
            return 0
        fi
    fi
    rm -f "$body" "$code_file"
    return 1
}

interpret_whois_file() {
    body="$1"
    if grep -Eqi 'redemptionPeriod|pendingDelete|REACTIVATION PERIOD' "$body"; then
        printf 'REDEMPTION\n'
        return
    fi
    if grep -Eqi 'clientTransferProhibited|Registry Domain ID:|Domain Name:|Registrar:|Creation Date:|Registry Expiry Date:|Registrar Registration Expiration Date:|Name Server:' "$body"; then
        printf 'REGISTERED\n'
        return
    fi
    if grep -Eqi 'No match|NOT FOUND|No Data Found|No entries found' "$body"; then
        printf 'AVAILABLE\n'
        return
    fi
    printf 'AMBIGUOUS\n'
}

check_whois() {
    domain="$1"
    have_cmd whois || return 1
    body="$BASE/whois.$$"
    rm -f "$body"
    whois "$domain" > "$body" 2>/dev/null
    rc=$?
    if [ "$rc" -ne 0 ] || [ ! -s "$body" ]; then
        rm -f "$body"
        printf 'WHOIS ERROR\n'
        return 0
    fi
    state="$(interpret_whois_file "$body")"
    printf 'WHOIS %s\n' "$state"
    rm -f "$body"
}

publish_available() {
    domain="$1"
    suffix="$2"
    add_message \
        --id "domain-drop-$suffix" \
        --source domain-watch \
        --type alert \
        --priority 9 \
        --title AVAILABLE \
        --body "$suffix" \
        --ttl 86400 \
        --repeat true \
        --duration 8 \
        --interval 60 \
        --detail "$domain may be available" >/dev/null
}

publish_ambiguous() {
    domain="$1"
    suffix="$2"
    add_message \
        --id "domain-check-$suffix" \
        --source domain-watch \
        --type alert \
        --priority 7 \
        --title CHECK \
        --body "$suffix" \
        --repeat true \
        --duration 6 \
        --interval 180 \
        --detail "Domain status changed: check manually" >/dev/null
}

publish_pending() {
    domain="$1"
    suffix="$2"
    add_message \
        --id "domain-pending-$suffix" \
        --source domain-watch \
        --type info \
        --priority 5 \
        --title REGISTERED \
        --body "$suffix" \
        --repeat false \
        --duration 4 \
        --indicator false \
        --detail "$domain is registered" >/dev/null
}

publish_error() {
    domain="$1"
    suffix="$2"
    add_message \
        --id "domain-error-$suffix" \
        --source domain-watch \
        --type alert \
        --priority 5 \
        --title "CHECK ERROR" \
        --body "$suffix" \
        --repeat false \
        --duration 4 \
        --detail "$domain check failed" >/dev/null
}

publish_redemption() {
    domain="$1"
    suffix="$2"
    add_message \
        --id "domain-redemption-$suffix" \
        --source domain-watch \
        --type alert \
        --priority 7 \
        --title REDEMPTION \
        --body "$suffix" \
        --ttl 86400 \
        --repeat true \
        --duration 8 \
        --interval 60 \
        --detail "$domain may be expiring" >/dev/null
}

check_domain() {
    domain=""
    suffix=""
    force=false
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --id) suffix="$(safe_id "${2:-}")"; shift 2 ;;
            --force) force=true; shift ;;
            --*) printf 'Unknown option: %s\n' "$1" >&2; return 2 ;;
            *)
                [ -z "$domain" ] && domain="$1" || { printf 'Unexpected argument: %s\n' "$1" >&2; return 2; }
                shift ;;
        esac
    done
    [ -z "$domain" ] && { printf 'Usage: chronomsg check-domain <domain> [--id suffix] [--force]\n' >&2; return 2; }
    domain="$(printf '%s' "$domain" | tr 'A-Z' 'a-z')"
    [ -n "$suffix" ] || suffix="$(domain_suffix "$domain")"
    [ -n "$suffix" ] || suffix=domain

    acquire_lock || return 0
    trap 'release_lock' EXIT HUP INT TERM
    log_msg "domain check started domain=$domain"

    result=""
    if result="$(check_whois "$domain")"; then
        method="${result%% *}"
        state="${result#* }"
        if { [ "$state" = AMBIGUOUS ] || [ "$state" = ERROR ]; } && result="$(check_rdap "$domain")"; then
            method="${result%% *}"
            state="${result#* }"
        fi
    elif result="$(check_rdap "$domain")"; then
        method="${result%% *}"
        state="${result#* }"
    else
        method=NONE
        state=ERROR
    fi

    previous="$(read_state)"
    log_msg "domain check method=$method state=$state previous=$previous"
    if [ "$state" != "$previous" ]; then
        log_msg "domain state transition $previous -> $state"
    fi
    write_state "$state"

    case "$state" in
        AVAILABLE)
            file="$(message_file_for_id "domain-drop-$suffix")"
            if [ "$force" = true ] || [ "$previous" != AVAILABLE ] || [ ! -f "$file" ]; then
                rm -f "$(message_file_for_id "domain-pending-$suffix")" \
                      "$(message_file_for_id "domain-check-$suffix")" \
                      "$(message_file_for_id "domain-redemption-$suffix")" \
                      "$(message_file_for_id "domain-error-$suffix")"
                publish_available "$domain" "$suffix"
            fi
            ;;
        AMBIGUOUS)
            file="$(message_file_for_id "domain-check-$suffix")"
            if [ "$force" = true ] || [ "$previous" != AMBIGUOUS ] || [ ! -f "$file" ]; then
                rm -f "$(message_file_for_id "domain-drop-$suffix")" \
                      "$(message_file_for_id "domain-pending-$suffix")" \
                      "$(message_file_for_id "domain-redemption-$suffix")" \
                      "$(message_file_for_id "domain-error-$suffix")"
                publish_ambiguous "$domain" "$suffix"
            fi
            ;;
        PENDING)
            file="$(message_file_for_id "domain-pending-$suffix")"
            if [ "$force" = true ] || [ "$previous" != PENDING ] || [ ! -f "$file" ]; then
                rm -f "$(message_file_for_id "domain-drop-$suffix")" \
                      "$(message_file_for_id "domain-check-$suffix")" \
                      "$(message_file_for_id "domain-redemption-$suffix")" \
                      "$(message_file_for_id "domain-error-$suffix")"
                publish_pending "$domain" "$suffix"
            fi
            ;;
        REGISTERED)
            file="$(message_file_for_id "domain-pending-$suffix")"
            if [ "$force" = true ] || [ "$previous" != REGISTERED ] || [ ! -f "$file" ]; then
                rm -f "$(message_file_for_id "domain-drop-$suffix")" \
                      "$(message_file_for_id "domain-check-$suffix")" \
                      "$(message_file_for_id "domain-redemption-$suffix")" \
                      "$(message_file_for_id "domain-error-$suffix")"
                publish_pending "$domain" "$suffix"
            fi
            ;;
        REDEMPTION)
            file="$(message_file_for_id "domain-redemption-$suffix")"
            if [ "$force" = true ] || [ "$previous" != REDEMPTION ] || [ ! -f "$file" ]; then
                rm -f "$(message_file_for_id "domain-drop-$suffix")" \
                      "$(message_file_for_id "domain-check-$suffix")" \
                      "$(message_file_for_id "domain-pending-$suffix")" \
                      "$(message_file_for_id "domain-error-$suffix")"
                publish_redemption "$domain" "$suffix"
            fi
            ;;
        ERROR|UNKNOWN)
            file="$(message_file_for_id "domain-error-$suffix")"
            if [ "$force" = true ] || [ "$previous" != ERROR ] || [ ! -f "$file" ]; then
                rm -f "$(message_file_for_id "domain-drop-$suffix")" \
                      "$(message_file_for_id "domain-check-$suffix")" \
                      "$(message_file_for_id "domain-pending-$suffix")" \
                      "$(message_file_for_id "domain-redemption-$suffix")"
                publish_error "$domain" "$suffix"
            fi
            ;;
        *)
            write_state AMBIGUOUS
            [ "$force" = true ] && publish_ambiguous "$domain" "$suffix"
            ;;
    esac
    release_lock
    trap - EXIT HUP INT TERM
}

test_domain() {
    domain="$1"
    [ -z "$domain" ] && { printf 'Usage: chronomsg test-domain <domain>\n' >&2; return 2; }
    suffix="$(domain_suffix "$domain")"
    domain="$(printf '%s' "$domain" | tr 'A-Z' 'a-z')"

    printf 'Testing: %s\n' "$domain"
    printf -- '─────────────────────────────────\n'

    state=ERROR
    method=""
    wbody="$BASE/whois-test.$$"
    rbody="$BASE/rdap-test.$$"
    rcode="$BASE/rdap-test-code.$$"

    # Step 1: WHOIS
    printf '1. WHOIS:\n'
    if have_cmd whois; then
        whois "$domain" > "$wbody" 2>/dev/null
        if [ -s "$wbody" ]; then
            printf '   Response:\n'
            head -c 300 "$wbody" | sed 's/^/   /'
            printf '\n'
            state="$(interpret_whois_file "$wbody")"
            method=WHOIS
            printf '   → interpret_whois_file → %s\n' "$state"
        else
            printf '   Empty response\n'
        fi
    else
        printf '   No whois command available\n'
    fi

    # Step 2: RDAP fallback if WHOIS failed or ambiguous
    if [ "$state" = AMBIGUOUS ] || [ "$state" = ERROR ] || [ -z "$method" ]; then
        printf '2. RDAP → %s\n' "$(rdap_url_for_domain "$domain")"
        if have_cmd curl; then
            fetch_rdap_curl "$domain" "$(rdap_url_for_domain "$domain")" "$rbody" "$rcode"
            code="$(sed -n '1p' "$rcode" 2>/dev/null)"
            printf '   HTTP %s\n' "${code:-timeout}"
            [ -s "$rbody" ] && printf '   Body: %s\n' "$(head -c 300 "$rbody" | tr '\n' ' ' | sed 's/[[:space:]]\{1,\}/ /g')"
            state="$(interpret_rdap "$rbody" "${code:-000}")"
            method=RDAP
            printf '   → interpret_rdap → %s\n' "$state"
        elif have_cmd wget; then
            fetch_rdap_wget "$domain" "$(rdap_url_for_domain "$domain")" "$rbody" "$rcode"
            code="$(sed -n '1p' "$rcode" 2>/dev/null)"
            if [ "${code:-000}" != 000 ] || [ -s "$rbody" ]; then
                printf '   HTTP %s\n' "${code:-timeout}"
                [ -s "$rbody" ] && printf '   Body: %s\n' "$(head -c 300 "$rbody" | tr '\n' ' ' | sed 's/[[:space:]]\{1,\}/ /g')"
                state="$(interpret_rdap "$rbody" "${code:-000}")"
                method=RDAP
                printf '   → interpret_rdap → %s\n' "$state"
            fi
        else
            printf '   No HTTP tool available\n'
        fi
    fi

    rm -f "$wbody" "$rbody" "$rcode"

    # Step 3: What would be displayed
    printf -- '─────────────────────────────────\n'
    printf 'Source:     %s\n' "${method:-NONE}"
    printf 'Result:     %s\n' "$state"
    case "$state" in
        AVAILABLE)
            printf 'Display:    "AVAILABLE" / "%s"\n' "$suffix"
            printf 'Mode:       flash (blinking)\n'
            printf 'Priority:   9\n'
            ;;
        AMBIGUOUS)
            printf 'Display:    "CHECK" / "%s"\n' "$suffix"
            printf 'Mode:       plain\n'
            printf 'Priority:   7\n'
            ;;
        PENDING)
            printf 'Display:    "REGISTERED" / "%s"\n' "$suffix"
            printf 'Mode:       plain\n'
            printf 'Priority:   5\n'
            ;;
        REGISTERED)
            printf 'Display:    "REGISTERED" / "%s"\n' "$suffix"
            printf 'Mode:       plain\n'
            printf 'Priority:   5\n'
            ;;
        REDEMPTION)
            printf 'Display:    "REDEMPTION" / "%s"\n' "$suffix"
            printf 'Mode:       flash\n'
            printf 'Priority:   7\n'
            ;;
        ERROR)
            printf 'Display:    "CHECK ERROR" / "%s"\n' "$suffix"
            printf 'Mode:       plain\n'
            printf 'Priority:   5\n'
            ;;
    esac
    printf -- '─────────────────────────────────\n'
}

# ===== Guest QR =====

guestqr_period_key() {
    case "${1:-weekly}" in
        daily)   date +%Y-%j ;;
        weekly)  date +%G-W%V ;;
        monthly) date +%Y-%m ;;
        yearly)  date +%Y ;;
    esac
}

guestqr_derive_password() {
    seed="$1"
    key="$2"
    len="${3:-12}"
    alphabet="${4:-ABCDEFGHJKLNPQRTUVXYZ}"
    alpha_len=$(printf '%s' "$alphabet" | wc -c | tr -d ' ')
    hash=$(printf '%s' "${seed}${key}" | md5sum | tr -d ' \n-' | cut -c1-32)
    pass="" i=1
    while [ "$(printf '%s' "$pass" | wc -c)" -lt "$len" ]; do
        pair=$(printf '%s' "$hash" | cut -c${i}-$((i+1)))
        val=$(( 0x$pair ))
        idx=$(( val % alpha_len + 1 ))
        char=$(printf '%s' "$alphabet" | cut -c${idx})
        pass="${pass}${char}"
        i=$((i + 2))
        if [ $((i + 1)) -gt 32 ]; then
            hash=$(printf '%s' "${hash}${seed}${key}" | md5sum | tr -d ' \n-' | cut -c1-32)
            i=1
        fi
    done
    printf '%s' "$pass"
}

guestqr_valid_until() {
    mode="${1:-weekly}"
    case "$mode" in
        daily)
            _today=$(date +%Y-%m-%d)
            date -d "$_today 23:59:59" +%s
            ;;
        weekly)
            _dow=$(date +%u)
            _now=$(date +%s)
            _days_left=$(( 7 - _dow ))
            _sun_date=$(date -d "@$(( _now + _days_left * 86400 ))" +%Y-%m-%d)
            date -d "$_sun_date 23:59:59" +%s
            ;;
        monthly)
            _m=$(( $(date +%m) + 0 ))
            _y=$(date +%Y)
            if [ "$_m" -eq 12 ]; then _ny=$(( _y + 1 )); _nm=1
            else _ny=$_y; _nm=$(( _m + 1 )); fi
            printf '%s\n' "$(( $(date -d "$(printf '%s-%02d-01 00:00:00' "$_ny" "$_nm")" +%s) - 1 ))"
            ;;
        yearly)
            _y=$(date +%Y)
            printf '%s\n' "$(( $(date -d "$(printf '%s-01-01 00:00:00' "$(( _y + 1 ))")" +%s) - 1 ))"
            ;;
    esac
}

guestqr_run() {
    rotate=weekly
    seed=""
    ssid="$GQR_SSID"
    section="$GQR_SECTION"
    length="$GQR_LENGTH"
    alphabet="$GQR_ALPHABET"
    outdir="$GQR_OUTDIR"
    no_apply=false
    no_html=false

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --rotate) rotate="${2:-weekly}"; shift 2 ;;
            --seed) seed="$2"; shift 2 ;;
            --ssid) ssid="$2"; shift 2 ;;
            --section) section="$2"; shift 2 ;;
            --length) length="${2:-12}"; shift 2 ;;
            --alphabet) alphabet="$2"; shift 2 ;;
            --outdir) outdir="$2"; shift 2 ;;
            --no-apply) no_apply=true; shift ;;
            --no-html) no_html=true; shift ;;
            *) printf 'Unknown guestqr option: %s\n' "$1" >&2; return 2 ;;
        esac
    done

    [ -z "$seed" ] && seed=$(tr -dc 'a-z0-9' < /dev/urandom | head -c 24 2>/dev/null || printf 'chronomsg-default-seed')

    gqr_lock="$BASE/guestqr.lock"
    if [ -f "$gqr_lock" ]; then
        now=$(now_epoch)
        ts=$(sed -n '1p' "$gqr_lock" 2>/dev/null)
        case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
        age=$(( now - ts ))
        if [ "$age" -lt "$LOCK_STALE_SEC" ]; then
            log_msg "guestqr skipped fresh lock age=${age}s"
            return 0
        fi
        log_msg "removing stale guestqr lock age=${age}s"
        rm -f "$gqr_lock"
    fi
    now_epoch > "$gqr_lock"
    trap 'rm -f "$gqr_lock"' EXIT HUP INT TERM

    state_file="$GQR_STATE"
    key=$(guestqr_period_key "$rotate")
    stored=$(cat "$state_file" 2>/dev/null || echo '')

    if [ "$stored" = "$key" ]; then
        log_msg "guestqr skipped current period=$key"
        rm -f "$gqr_lock"
        trap - EXIT HUP INT TERM
        return 0
    fi

    password=$(guestqr_derive_password "$seed" "$key" "$length" "$alphabet")
    [ -z "$password" ] && { log_msg "guestqr failed empty password"; return 1; }

    if [ "$no_apply" = false ]; then
        uci set wireless."$section".key="$password" 2>/dev/null || log_msg "guestqr uci set failed"
        uci commit wireless 2>/dev/null || log_msg "guestqr uci commit failed"
        wifi reload 2>/dev/null || wifi 2>/dev/null || log_msg "guestqr wifi reload failed"
    fi

    mkdir -p "$outdir"
    printf '%s\n%s\n' "$ssid" "$password" > "$outdir/guest.txt"

    if [ "$no_html" = false ]; then
        display_pass=$(printf '%s' "$password" | sed 's/.\{4\}/& /g;s/ $//')
        qrdata="WIFI:T:WPA;S:${ssid};P:${password};;"
        if have_cmd qrencode; then
            qrencode -t SVG -o "$outdir/guestwifi.svg" "$qrdata" 2>/dev/null || true
        fi
        case "$rotate" in
            daily)   valid_txt="Valid until midnight" ;;
            weekly)  _dow=$(date +%u); _days_left=$(( 7 - _dow ))
                     valid_txt="Valid until Sunday $(LC_TIME=C date -d "@$(( $(date +%s) + _days_left * 86400 ))" '+%B %-d, %Y' 2>/dev/null || echo 'end of week')" ;;
            monthly) valid_txt="Valid until end of $(LC_TIME=C date '+%B %Y')" ;;
            yearly)  valid_txt="Valid until end of $(date +%Y)" ;;
        esac
        cat > "$outdir/index.html" <<PAGE
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${ssid}</title>
<style>
body {
  margin: 0;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #111;
  font-family: sans-serif;
}

.wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.ssid {
  font-weight: 700;
  white-space: nowrap;
  margin-bottom: 3px;
}

.qr {
  width: 100%;
  display: block;
}

.password {
  font-weight: 700;
  letter-spacing: 0.08em;
  white-space: nowrap;
  margin-top: 3px;
}

.valid {
  color: #888;
  white-space: nowrap;
  margin-top: 2px;
}
</style>
</head>
<body>
  <div class="wrap">
    <div class="ssid">${ssid}</div>
    <img class="qr" src="guestwifi.svg?$(date +%s)" alt="WiFi QR code">
    <div class="password">${display_pass}</div>
    <div class="valid">${valid_txt}</div>
  </div>
  <script>
    function fitText(el, maxW, maxPx) {
      var prev = el.style.display;
      el.style.display = 'inline';
      var lo = 1, hi = maxPx || 500;
      while (lo < hi) {
        var mid = (lo + hi + 1) >> 1;
        el.style.fontSize = mid + 'px';
        if (el.offsetWidth <= maxW) lo = mid; else hi = mid - 1;
      }
      el.style.fontSize = lo + 'px';
      el.style.display = prev;
    }
    function applyFit(w) {
      var wrap = document.querySelector('.wrap');
      wrap.style.width = w + 'px';
      fitText(document.querySelector('.ssid'), w);
      var pw = document.querySelector('.password');
      fitText(pw, w);
      fitText(document.querySelector('.valid'), w, Math.round(parseFloat(pw.style.fontSize) * 0.65));
    }
    function resizeAll() {
      var maxW = window.innerWidth  * 0.98;
      var maxH = window.innerHeight * 0.98;
      var lo = 50, hi = maxW;
      while (hi - lo > 1) {
        var mid = (lo + hi) / 2;
        applyFit(mid);
        if (document.querySelector('.wrap').offsetHeight <= maxH) lo = mid; else hi = mid - 1;
      }
      applyFit(lo);
    }
    var img = document.querySelector('.qr');
    function init() { document.fonts.ready.then(resizeAll); }
    if (img.complete) { init(); } else { img.addEventListener('load', init); }
    window.addEventListener('resize', resizeAll);
    setTimeout(function() { location.reload(); }, 5 * 60 * 1000);
  </script>
</body>
</html>
PAGE
        cp "$outdir/index.html" "$outdir/gl_home.html" 2>/dev/null || true
        chmod 644 "$outdir/guestwifi.svg" "$outdir/index.html" "$outdir/gl_home.html" 2>/dev/null || true
    fi

    chmod 644 "$outdir/guest.txt"
    printf '%s\n' "$key" > "$state_file"
    log_msg "guestqr rotated ssid=${ssid} period=${key}"
    rm -f "$gqr_lock"
    trap - EXIT HUP INT TERM
}

# ===== Cron management =====

reload_cron() {
    [ "${CHRONOMSG_NO_CRON_RELOAD:-0}" = 1 ] && return 0
    if [ -x /etc/init.d/cron ]; then
        /etc/init.d/cron restart >/dev/null 2>&1 || /etc/init.d/cron reload >/dev/null 2>&1 || true
    fi
}

cron_list() {
    if [ -f "$CRON_FILE" ]; then
        grep "/usr/bin/chronomsg" "$CRON_FILE" || printf 'no chronomsg cron entries\n'
    else
        printf 'no chronomsg cron entries\n'
    fi
}

cron_add() {
    feature="${1:-}"
    shift 2>/dev/null || true
    [ -z "$feature" ] && { printf 'Usage: chronomsg cron add check-domain <domain>|guestqr [--hour H] [--minute M] [--weekday N]\n' >&2; return 2; }
    ensure_base
    mkdir -p "$(dirname "$CRON_FILE")" 2>/dev/null || true
    line=""
    case "$feature" in
        check-domain)
            domain="${1:-}"
            [ -z "$domain" ] && { printf 'Usage: chronomsg cron add check-domain <domain>\n' >&2; return 2; }
            line="0 * * * * /usr/bin/chronomsg check-domain $domain >$BASE/domain-check.log 2>&1"
            ;;
        guestqr)
            hour=3; minute=0; weekday="*"
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --hour) hour="${2:-3}"; shift 2 ;;
                    --minute) minute="${2:-0}"; shift 2 ;;
                    --weekday) weekday="${2:-*}"; shift 2 ;;
                    *) shift ;;
                esac
            done
            line="$minute $hour * * $weekday /usr/bin/chronomsg guestqr >/dev/null 2>&1"
            ;;
        *)
            printf 'Unknown cron feature: %s\n' "$feature" >&2
            return 2
            ;;
    esac
    if [ -f "$CRON_FILE" ] && grep -Fqx "$line" "$CRON_FILE" 2>/dev/null; then
        printf 'already installed: %s\n' "$line"
        return 0
    fi
    printf '%s\n' "$line" >> "$CRON_FILE"
    reload_cron
    printf 'installed cron: %s\n' "$line"
}

cron_remove() {
    feature="${1:-}"
    [ -z "$feature" ] && { printf 'Usage: chronomsg cron remove check-domain|guestqr\n' >&2; return 2; }
    ensure_base
    tmp="$BASE/crontab.$$"
    if [ -f "$CRON_FILE" ]; then
        grep -v "/usr/bin/chronomsg $feature " "$CRON_FILE" > "$tmp" 2>/dev/null || true
        mv "$tmp" "$CRON_FILE"
    fi
    reload_cron
    printf 'removed %s cron entries\n' "$feature"
}

cron_uninstall() {
    ensure_base
    tmp="$BASE/crontab.$$"
    if [ -f "$CRON_FILE" ]; then
        grep -v "/usr/bin/chronomsg" "$CRON_FILE" > "$tmp" 2>/dev/null || true
        mv "$tmp" "$CRON_FILE"
    fi
    reload_cron
    printf 'removed all chronomsg cron entries\n'
}

usage() {
    cat <<'EOF'
Usage:
  chronomsg serve [--cgi]
  chronomsg add [options] TITLE BODY
  chronomsg clear ID
  chronomsg list
  chronomsg rebuild
  chronomsg dismiss ID
  chronomsg undismiss ID
  chronomsg dismissed
  chronomsg check-domain <domain> [--id suffix] [--force]
  chronomsg test-domain <domain>
  chronomsg guestqr [options]
  chronomsg cron list|add|remove|uninstall
  chronomsg help

Add options:
  --id ID              Message identifier (auto-generated if omitted)
  --source SOURCE      Source label (default: manual)
  --type TYPE          Message type (default: alert)
  --priority N         Priority 0-9 (default: 5)
  --ttl SEC            Time-to-live seconds (default: 3600)
  --title TITLE        Override displayed title
  --body BODY          Override displayed body
  --detail TEXT        Internal detail (not shown on clock)
  --repeat true|false  Auto-repeat notification (default: false)
  --duration SEC       Preview duration 3-15s (default: 6)
  --interval SEC       Repeat interval in seconds
  --indicator true|false  Show blinking indicator (default: true)
  --dismissible true|false  Allow dismiss via center tap (default: true)

Guestqr options:
  --rotate MODE        Rotation period: daily, weekly, monthly, yearly
  --seed TEXT          Deterministic seed (auto-generated if omitted)
  --ssid NAME          WiFi SSID (default: NEXO-GUEST)
  --section ID         UCI wireless section (default: guest2g)
  --length N           Password length (default: 12)
  --alphabet CHARS     Password character set
  --outdir PATH        Output directory (default: /www/qr)
  --no-apply           Skip uci wireless update
  --no-html            Skip HTML/QR file generation

Cron commands:
  cron list            List active chronomsg cron entries
  cron add check-domain <domain>             Hourly domain check
  cron add guestqr [--hour H] [--minute M] [--weekday N]   Guest QR rotation (default: daily)
  cron remove check-domain|guestqr           Remove cron entries by feature
  cron uninstall                             Remove all chronomsg cron entries
EOF
}

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
    serve)
        cgi=false
        [ "${REQUEST_METHOD:-}${GATEWAY_INTERFACE:-}${SCRIPT_NAME:-}" != "" ] && cgi=true
        if [ "${1:-}" = "--cgi" ]; then
            cgi=true
            shift
        fi
        [ "$#" -eq 0 ] || {
            printf 'Unexpected serve argument\n' >&2
            exit 2
        }
        serve_payload "$cgi"
        ;;
    add)
        add_message "$@"
        ;;
    clear|remove)
        clear_message "$@"
        ;;
    list)
        list_messages
        ;;
    dismiss)
        dismiss_message "$@"
        ;;
    undismiss)
        undismiss_message "$@"
        ;;
    dismissed)
        list_dismissed
        ;;
    rebuild)
        rebuild_payload
        ;;
    check-domain)
        check_domain "$@"
        ;;
    test-domain)
        test_domain "$@"
        ;;
    guestqr)
        guestqr_run "$@"
        ;;
    cron)
        subcmd="${1:-help}"
        shift 2>/dev/null || true
        case "$subcmd" in
            list) cron_list ;;
            add) cron_add "$@" ;;
            remove) cron_remove "$@" ;;
            uninstall) cron_uninstall ;;
            *) printf 'Usage: chronomsg cron list|add|remove|uninstall\n' >&2; exit 2 ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
