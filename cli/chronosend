#!/bin/sh
# chronosend - send display messages to ChronoBell

set -eu

CHRONOSERVE_URL="${CHRONOSERVE_URL:-http://192.168.8.1/cgi-bin/chronoserve}"

DEFAULT_MPD_FORMAT="%title% BY %artist%"
DEFAULT_MPD_REPEAT_SEC=300
DEFAULT_MPD_TTL_BUFFER=10
DEFAULT_MPD_FALLBACK_TTL=300

INSTALL_DIR="${INSTALL_DIR:-${HOME}/.local/bin}"
SERVICE_DIR="${SERVICE_DIR:-${HOME}/.config/systemd/user}"
SERVICE_NAME="chronosend-mpd"

CHRONOSEND_DEBUG="${CHRONOSEND_DEBUG:-false}"
CHRONOSEND_DRY_RUN="${CHRONOSEND_DRY_RUN:-false}"

usage() {
    cat <<'EOF'
Usage:
  chronosend [options] "message"
  echo "message" | chronosend
  chronosend mpd [options]
  chronosend install
  chronosend uninstall

Message policy:
  -i, --inbox          keep in message view until dismissed
  -r, --repeat SEC    repeat preview until TTL expires
  --ttl SEC           active lifetime in seconds (default: 600)
  --forever           no expiry

Display:
  -t, --title TEXT    optional title
  -p, --priority N    priority 0-9 (default: 5)
  --small             small font
  --medium            medium font (default)
  --big               big font
  --bell PATTERN      bell strikes, e.g. 3 or 3,2,1

MPD:
  chronosend mpd --interval SEC --ttl-buffer SEC --fallback-ttl SEC --format FORMAT

Utility:
  --id ID
  --dry-run
  --debug
EOF
    exit 0
}

debug_log() {
    [ "$CHRONOSEND_DEBUG" = true ] && echo "[debug] $*" >&2
    return 0
}

have_cmd() {
    command -v "$1" >/dev/null 2>&1
}

curl_get() {
    if [ "$CHRONOSEND_DRY_RUN" = true ]; then
        echo "[dry-run] $CHRONOSERVE_URL"
        for arg do echo "  $arg"; done
        return 0
    fi
    curl -s -G "$CHRONOSERVE_URL" "$@" >/dev/null 2>&1
}

parse_time() {
    v="${1:-}"
    case "$v" in
        *:*)
            min="${v%:*}"
            sec="${v##*:}"
            case "$min$sec" in *[!0-9]*|'') printf '0\n' ;; *) printf '%s\n' $((min * 60 + sec)) ;; esac
            ;;
        ''|*[!0-9]*) printf '0\n' ;;
        *) printf '%s\n' "$v" ;;
    esac
}

positive_int_or_zero() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

send_message() {
    id=""
    body=""
    title=""
    policy=temporary
    repeat=""
    ttl=600
    priority=5
    size=medium
    size_set=false
    bell=""

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --id) id="${2:-}"; shift 2 ;;
            -t|--title) title="${2:-}"; shift 2 ;;
            -i|--inbox)
                [ "$policy" = temporary ] || { echo "chronosend: choose only one policy: default temporary, --inbox, or --repeat" >&2; exit 2; }
                policy=inbox
                shift ;;
            -r|--repeat)
                [ "$policy" = temporary ] || { echo "chronosend: choose only one policy: default temporary, --inbox, or --repeat" >&2; exit 2; }
                policy=repeat
                repeat="${2:-}"
                shift 2 ;;
            --ttl) ttl="${2:-}"; shift 2 ;;
            --forever) ttl=forever; shift ;;
            -p|--priority) priority="${2:-}"; shift 2 ;;
            --small)
                [ "$size_set" = false ] || { echo "chronosend: choose only one font size: --small, --medium, or --big" >&2; exit 2; }
                size=small
                size_set=true
                shift ;;
            --medium)
                [ "$size_set" = false ] || { echo "chronosend: choose only one font size: --small, --medium, or --big" >&2; exit 2; }
                size=medium
                size_set=true
                shift ;;
            --big)
                [ "$size_set" = false ] || { echo "chronosend: choose only one font size: --small, --medium, or --big" >&2; exit 2; }
                size=big
                size_set=true
                shift ;;
            --bell) bell="${2:-}"; shift 2 ;;
            --dry-run) CHRONOSEND_DRY_RUN=true; shift ;;
            --debug) CHRONOSEND_DEBUG=true; shift ;;
            --help|-h) usage ;;
            --stdin) shift ;;
            -*) echo "chronosend: unknown option: $1" >&2; exit 2 ;;
            *) body="$1"; shift ;;
        esac
    done

    if [ -z "$body" ] && [ ! -t 0 ]; then
        read -r body || true
    fi
    [ -n "$body" ] || { echo "chronosend: message required (argument or pipe)" >&2; exit 2; }
    [ "$policy" != repeat ] || [ -n "$repeat" ] || { echo "chronosend: --repeat requires seconds" >&2; exit 2; }
    have_cmd curl || { echo "chronosend: curl not found" >&2; exit 1; }

    set -- --data-urlencode "add=" \
           --data-urlencode "body=$body" \
           --data-urlencode "source=cli" \
           --data-urlencode "policy=$policy" \
           --data-urlencode "ttl=$ttl" \
           --data-urlencode "priority=$priority" \
           --data-urlencode "size=$size"
    [ -n "$id" ] && set -- "$@" --data-urlencode "id=$id"
    [ -n "$title" ] && set -- "$@" --data-urlencode "title=$title"
    [ -n "$repeat" ] && set -- "$@" --data-urlencode "repeat=$repeat"
    [ -n "$bell" ] && set -- "$@" --data-urlencode "bell=$bell"

    debug_log "send policy=$policy size=$size ttl=$ttl body=\"$body\""
    curl_get "$@" || {
        echo "chronosend: failed to send (router unreachable?)" >&2
        return 1
    }
}

clear_message() {
    id="$1"
    if [ "$CHRONOSEND_DRY_RUN" = true ]; then
        echo "[dry-run] clear $id"
        return 0
    fi
    curl -s -G "$CHRONOSERVE_URL" \
        --data-urlencode "clear=" \
        --data-urlencode "id=$id" >/dev/null 2>&1 || true
}

run_mpd() {
    have_cmd mpc || { echo "chronosend: mpc not found (install with: apt install mpc)" >&2; exit 1; }
    have_cmd curl || { echo "chronosend: curl not found" >&2; exit 1; }

    format="${CHRONOSEND_MPD_FORMAT:-$DEFAULT_MPD_FORMAT}"
    interval="${CHRONOSEND_MPD_REPEAT_SEC:-$DEFAULT_MPD_REPEAT_SEC}"
    ttl_buffer="${CHRONOSEND_MPD_TTL_BUFFER:-$DEFAULT_MPD_TTL_BUFFER}"
    fallback_ttl="${CHRONOSEND_MPD_FALLBACK_TTL:-$DEFAULT_MPD_FALLBACK_TTL}"
    size=medium
    last=""
    next_repeat=0
    repeat_until=0

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --interval) interval="${2:-}"; shift 2 ;;
            --ttl-buffer) ttl_buffer="${2:-}"; shift 2 ;;
            --fallback-ttl) fallback_ttl="${2:-}"; shift 2 ;;
            --format) format="${2:-}"; shift 2 ;;
            --small) size=small; shift ;;
            --medium) size=medium; shift ;;
            --big) size=big; shift ;;
            --dry-run) CHRONOSEND_DRY_RUN=true; shift ;;
            --debug) CHRONOSEND_DEBUG=true; shift ;;
            --help|-h) usage ;;
            *) echo "chronosend mpd: unknown option: $1" >&2; exit 2 ;;
        esac
    done
    positive_int_or_zero "$interval" || { echo "chronosend mpd: --interval must be seconds, or 0 to disable repeats" >&2; exit 2; }
    positive_int_or_zero "$ttl_buffer" || { echo "chronosend mpd: --ttl-buffer must be seconds" >&2; exit 2; }
    positive_int_or_zero "$fallback_ttl" || { echo "chronosend mpd: --fallback-ttl must be seconds" >&2; exit 2; }
    [ "$fallback_ttl" -gt 0 ] || { echo "chronosend mpd: --fallback-ttl must be greater than 0" >&2; exit 2; }

    trap 'clear_message mpd-now-playing; exit 0' TERM INT

    while true; do
        song="$(mpc current -f "$format" 2>/dev/null || true)"
        debug_log "MPD current=\"$song\""
        if [ -z "$song" ]; then
            if [ -n "$last" ]; then
                clear_message mpd-now-playing
                last=""
                next_repeat=0
                repeat_until=0
            fi
            sleep 2
            continue
        fi

        now="$(date +%s 2>/dev/null || printf '0')"
        if [ "$song" != "$last" ]; then
            last="$song"
            time_field="$(mpc status "%time%" 2>/dev/null || true)"
            elapsed_part="${time_field%%/*}"
            total_part="${time_field#*/}"
            [ "$total_part" != "$time_field" ] || total_part="$(mpc status "%totaltime%" 2>/dev/null || true)"
            elapsed_secs="$(parse_time "$elapsed_part")"
            total_secs="$(parse_time "$total_part")"
            if [ "${total_secs:-0}" -gt 0 ] 2>/dev/null; then
                remaining=$((total_secs - elapsed_secs))
                [ "$remaining" -gt 0 ] || remaining=1
                repeat_until=$((now + remaining))
            else
                remaining="$fallback_ttl"
                repeat_until=$((now + fallback_ttl))
            fi

            if [ "$interval" -gt 0 ] && [ "$remaining" -gt "$interval" ]; then
                ttl=$((interval + ttl_buffer))
            else
                ttl=$((remaining + ttl_buffer))
            fi
            [ "$ttl" -gt 0 ] || ttl=1

            debug_log "MPD first ttl=$ttl repeat_until=$repeat_until interval=$interval"
            send_message --id mpd-now-playing --ttl "$ttl" --priority 5 "--$size" "NOW PLAYING $song" || true
            if [ "$interval" -gt 0 ]; then
                next_repeat=$((now + interval))
            else
                next_repeat=0
            fi
        elif [ "$interval" -gt 0 ] && [ "$next_repeat" -gt 0 ] &&
             [ "$repeat_until" -gt 0 ] && [ "$now" -ge "$next_repeat" ] &&
             [ "$now" -lt "$repeat_until" ]; then
            remaining=$((repeat_until - now))
            if [ "$remaining" -gt "$interval" ]; then
                ttl=$((interval + ttl_buffer))
            else
                ttl=$((remaining + ttl_buffer))
            fi
            [ "$ttl" -gt 0 ] || ttl=1

            debug_log "MPD repeat ttl=$ttl repeat_until=$repeat_until interval=$interval"
            send_message --id mpd-now-playing --ttl "$ttl" --priority 5 "--$size" "$song" || true
            next_repeat=$((now + interval))
        fi

        sleep 1
    done
}

do_install() {
    printf 'chronosend: creating directories...\n'
    mkdir -p "$INSTALL_DIR" "$SERVICE_DIR"

    self="$(realpath "$0" 2>/dev/null || readlink -f "$0" 2>/dev/null || echo "$0")"
    was_active=false
    systemctl --user is-active "$SERVICE_NAME" >/dev/null 2>&1 && was_active=true

    if [ "$self" != "$INSTALL_DIR/chronosend" ]; then
        printf 'chronosend: copying binary to %s/chronosend...\n' "$INSTALL_DIR"
        cp "$self" "$INSTALL_DIR/chronosend"
        chmod 755 "$INSTALL_DIR/chronosend"
    fi

    printf 'chronosend: writing service to %s/%s.service...\n' "$SERVICE_DIR" "$SERVICE_NAME"
    cat > "$SERVICE_DIR/$SERVICE_NAME.service" <<EOF
[Unit]
Description=ChronoBell MPD now-playing
After=network-online.target
Wants=mpd.service

[Service]
ExecStart=$INSTALL_DIR/chronosend mpd
Restart=always
RestartSec=5
Environment=CHRONOSEND_MPD_FORMAT="%%title%% BY %%artist%%"

[Install]
WantedBy=default.target
EOF

    printf 'chronosend: reloading systemd user daemon...\n'
    systemctl --user daemon-reload 2>/dev/null || true

    if [ "$was_active" = true ]; then
        printf 'chronosend: restarting %s...\n' "$SERVICE_NAME"
        systemctl --user restart "$SERVICE_NAME" 2>/dev/null \
            || printf 'chronosend: warning - could not restart %s\n' "$SERVICE_NAME" >&2
    else
        printf 'chronosend: enabling and starting %s...\n' "$SERVICE_NAME"
        systemctl --user enable --now "$SERVICE_NAME" 2>/dev/null \
            || printf 'chronosend: warning - could not enable %s\n' "$SERVICE_NAME" >&2
    fi

    printf 'chronosend: installed to %s/chronosend\n' "$INSTALL_DIR"
}

do_uninstall() {
    printf 'chronosend: stopping and disabling %s...\n' "$SERVICE_NAME"
    systemctl --user disable --now "$SERVICE_NAME" 2>/dev/null || true

    printf 'chronosend: removing service file %s/%s.service...\n' "$SERVICE_DIR" "$SERVICE_NAME"
    rm -f "$SERVICE_DIR/$SERVICE_NAME.service"

    printf 'chronosend: reloading systemd user daemon...\n'
    systemctl --user daemon-reload 2>/dev/null || true

    printf 'chronosend: removing binary %s/chronosend...\n' "$INSTALL_DIR"
    rm -f "$INSTALL_DIR/chronosend"

    printf 'chronosend: removed\n'
}

case "${1:-}" in
    mpd) shift; run_mpd "$@" ;;
    install) do_install ;;
    uninstall) do_uninstall ;;
    --help|-h|help) usage ;;
    *) send_message "$@" ;;
esac
