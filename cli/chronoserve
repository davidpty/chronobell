#!/bin/sh

BASE="${CHRONOSERVE_BASE:-/etc/chronoserve}"
MSG_DIR="${CHRONOSERVE_MSG_DIR:-$BASE/messages.d}"
OUT="${CHRONOSERVE_OUT:-$BASE/messages.json}"
STATE_BASE="${CHRONOSERVE_STATE_FILE:-$BASE/domain-state}"
LOCK_BASE="${CHRONOSERVE_LOCK_FILE:-$BASE/check-domain.lock}"
LOG_FILE="${CHRONOSERVE_LOG_FILE:-$BASE/chronoserve.log}"
CRON_FILE="${CHRONOSERVE_CRON_FILE:-/etc/crontabs/root}"
GQR_STATE="${CHRONOSERVE_GQR_STATE:-$BASE/guestqr-state}"
GQR_CONFIG="${CHRONOSERVE_GQR_CONFIG:-$BASE/guestqr-config}"
GQR_SEED="${CHRONOSERVE_GQR_SEED:-$BASE/guestqr-seed}"
GQR_SSID="${CHRONOSERVE_GQR_SSID:-NEXO-GUEST}"
GQR_SECTION="${CHRONOSERVE_GQR_SECTION:-guest2g}"
GQR_ROTATE="${CHRONOSERVE_GQR_ROTATE:-weekly}"
GQR_LENGTH="${CHRONOSERVE_GQR_LENGTH:-12}"
GQR_ALPHABET="${CHRONOSERVE_GQR_ALPHABET:-ABCDEFGHJKLNPQRTUVXYZ}"
GQR_OUTDIR="${CHRONOSERVE_GQR_OUTDIR:-/www/qr}"
DISMISSED_FILE="${CHRONOSERVE_DISMISSED_FILE:-$BASE/dismissed}"
LOCK_STALE_SEC=900
DISMISSED_RETENTION_SEC=31536000

ensure_base() {
    mkdir -p "$BASE" "$MSG_DIR"
}

now_epoch() {
    date +%s 2>/dev/null || printf '0\n'
}

safe_text() {
    printf '%s' "$1" | sed 's/[^A-Za-z0-9 ._\/:-]/ /g; s/[ ][ ]*/ /g; s/^ //; s/ $//'
}

safe_id() {
    printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/[^a-z0-9._-]/-/g; s/--*/-/g; s/^-//; s/-$//'
}

domain_suffix() {
    domain="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
    first="${domain%%.*}"
    safe_id "${first:-$domain}"
}

state_file_for_suffix() {
    printf '%s-%s' "$STATE_BASE" "$(safe_id "$1")"
}

lock_file_for_suffix() {
    printf '%s-%s' "$LOCK_BASE" "$(safe_id "$1")"
}

json_escape() {
    safe_text "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

json_escape_raw() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

guestqr_default_config() {
    rotate="$GQR_ROTATE"
    ssid="$GQR_SSID"
    section="$GQR_SECTION"
    length="$GQR_LENGTH"
    alphabet="$GQR_ALPHABET"
    outdir="$GQR_OUTDIR"
}

guestqr_load_config() {
    guestqr_default_config
    [ -f "$GQR_CONFIG" ] || return 0
    rotate="$(sed -n '1p' "$GQR_CONFIG" 2>/dev/null)"
    ssid="$(sed -n '2p' "$GQR_CONFIG" 2>/dev/null)"
    section="$(sed -n '3p' "$GQR_CONFIG" 2>/dev/null)"
    length="$(sed -n '4p' "$GQR_CONFIG" 2>/dev/null)"
    alphabet="$(sed -n '5p' "$GQR_CONFIG" 2>/dev/null)"
    outdir="$(sed -n '6p' "$GQR_CONFIG" 2>/dev/null)"
    [ -n "$rotate" ] || rotate="$GQR_ROTATE"
    [ -n "$ssid" ] || ssid="$GQR_SSID"
    [ -n "$section" ] || section="$GQR_SECTION"
    [ -n "$length" ] || length="$GQR_LENGTH"
    [ -n "$alphabet" ] || alphabet="$GQR_ALPHABET"
    [ -n "$outdir" ] || outdir="$GQR_OUTDIR"
}

guestqr_save_config() {
    ensure_base
    tmp="$GQR_CONFIG.$$"
    {
        printf '%s\n' "$rotate"
        printf '%s\n' "$ssid"
        printf '%s\n' "$section"
        printf '%s\n' "$length"
        printf '%s\n' "$alphabet"
        printf '%s\n' "$outdir"
    } > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    mv "$tmp" "$GQR_CONFIG"
    chmod 600 "$GQR_CONFIG" 2>/dev/null || true
}

guestqr_resolve_seed() {
    seed_value="${1:-}"
    if [ -n "$seed_value" ]; then
        printf '%s' "$seed_value"
        return 0
    fi
    if [ -f "$GQR_SEED" ]; then
        sed -n '1p' "$GQR_SEED" 2>/dev/null
        return 0
    fi
    tr -dc 'a-z0-9' < /dev/urandom | head -c 24 2>/dev/null || printf 'chronoserve-default-seed'
}

guestqr_save_seed() {
    ensure_base
    tmp="$GQR_SEED.$$"
    printf '%s\n' "$1" > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    mv "$tmp" "$GQR_SEED"
    chmod 600 "$GQR_SEED" 2>/dev/null || true
}

guestqr_state_stamp() {
    printf '%s|%s|%s|%s|%s|%s' "$rotate" "$ssid" "$section" "$length" "$alphabet" "$seed"
}

guestqr_current_password() {
    key="$(guestqr_period_key "$rotate")"
    guestqr_derive_password "$seed" "$key" "$length" "$alphabet"
}

guestwifi_json_fragment() {
    guestqr_load_config
    [ -f "$GQR_CONFIG" ] || guestqr_save_config
    password=""
    if have_cmd uci; then
        live_ssid="$(uci get wireless."$section".ssid 2>/dev/null || true)"
        live_password="$(uci get wireless."$section".key 2>/dev/null || true)"
        if [ -n "$live_password" ]; then
            [ -n "$live_ssid" ] && ssid="$live_ssid"
            password="$live_password"
        fi
    fi
    if [ -z "$password" ]; then
        seed="$(guestqr_resolve_seed)"
        [ -n "$seed" ] || seed="chronoserve-default-seed"
        [ -f "$GQR_SEED" ] || guestqr_save_seed "$seed"
        password="$(guestqr_current_password)"
    fi
    printf ',"guestwifi":{"ssid":"%s","password":"%s"}' "$(json_escape_raw "$ssid")" "$(json_escape_raw "$password")"
}

hex_value() {
    case "$1" in
        0) printf 0 ;;
        1) printf 1 ;;
        2) printf 2 ;;
        3) printf 3 ;;
        4) printf 4 ;;
        5) printf 5 ;;
        6) printf 6 ;;
        7) printf 7 ;;
        8) printf 8 ;;
        9) printf 9 ;;
        a|A) printf 10 ;;
        b|B) printf 11 ;;
        c|C) printf 12 ;;
        d|D) printf 13 ;;
        e|E) printf 14 ;;
        f|F) printf 15 ;;
        *) printf 0 ;;
    esac
}

url_decode() {
    input="$(printf '%s' "$1" | sed 's/+/ /g')"
    output=""
    while [ -n "$input" ]; do
        case "$input" in
            %[0-9A-Fa-f][0-9A-Fa-f]*)
                rest="$(printf '%s' "$input" | sed 's/^%//')"
                h1="$(printf '%.1s' "$rest")"
                rest="$(printf '%s' "$rest" | sed 's/^.//')"
                h2="$(printf '%.1s' "$rest")"
                input="$(printf '%s' "$rest" | sed 's/^.//')"
                v1="$(hex_value "$h1")"
                v2="$(hex_value "$h2")"
                dec=$(( v1 * 16 + v2 ))
                oct="$(printf '%03o' "$dec")"
                char="$(printf "\\$oct")"
                output="$output$char"
                ;;
            *)
                char="$(printf '%.1s' "$input")"
                output="$output$char"
                input="$(printf '%s' "$input" | sed 's/^.//')"
                ;;
        esac
    done
    printf '%s' "$output"
}

request_data() {
    data="${QUERY_STRING:-}"
    if [ "${REQUEST_METHOD:-}" = POST ] && [ "${CONTENT_LENGTH:-0}" -gt 0 ] 2>/dev/null; then
        body="$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)"
        if [ -n "$body" ]; then
            [ -n "$data" ] && data="$data&$body" || data="$body"
        fi
    fi
    printf '%s' "$data"
}

query_param_value() {
    query="${CHRONOSERVE_REQUEST_DATA:-${QUERY_STRING:-}}"
    key="$1"
    case "$query" in
        "$key="*|*"&$key="*) url_decode "$(printf '%s' "$query" | sed "s/.*$key=//; s/&.*//")" ;;
        *) printf '' ;;
    esac
}

query_param_present() {
    query="${CHRONOSERVE_REQUEST_DATA:-${QUERY_STRING:-}}"
    key="$1"
    case "&$query&" in
        *"&$key&"*|*"&$key="*) return 0 ;;
        *) return 1 ;;
    esac
}

bool_value() {
    case "${1:-false}" in
        1|true|TRUE|yes|YES|on|ON) printf true ;;
        *) printf false ;;
    esac
}

num_value() {
    case "${1:-}" in
        ''|*[!0-9]*) printf '%s' "$2" ;;
        *) printf '%s' "$1" ;;
    esac
}

policy_value() {
    case "${1:-temporary}" in
        temporary|repeat|inbox) printf '%s' "$1" ;;
        *) printf 'temporary' ;;
    esac
}

size_value() {
    case "${1:-medium}" in
        small|medium|big) printf '%s' "$1" ;;
        0) printf 'small' ;;
        1) printf 'medium' ;;
        2) printf 'big' ;;
        *) printf 'medium' ;;
    esac
}

message_file_for_id() {
    printf '%s/%s.json' "$MSG_DIR" "$(safe_id "$1")"
}

write_message_payload() {
    now="$(now_epoch)"
    {
        printf '{"device":"chronobell","now":%s,"messages":[]}\n' "$now"
    } > "$OUT"
}

write_wifi_payload() {
    now="$(now_epoch)"
    {
        printf '{"device":"chronobell","now":%s' "$now"
        guestwifi_json_fragment
        printf '}\n'
    } > "$OUT"
}

is_dismissed() {
    id="$1"
    [ -f "$DISMISSED_FILE" ] || return 1
    now="$(now_epoch)"
    while IFS= read -r line; do
        set -- $line
        [ "$1" = "$id" ] || continue
        case "${2:-}" in
            ''|*[!0-9]*) return 0 ;;
        esac
        age=$((now - $2))
        [ "$age" -lt 0 ] && return 0
        [ "$age" -le "$DISMISSED_RETENTION_SEC" ] && return 0
    done < "$DISMISSED_FILE" 2>/dev/null
    return 1
}

cleanup_dismissed() {
    [ -f "$DISMISSED_FILE" ] || return 0
    now="$(now_epoch)"
    tmp_d="$BASE/dismissed.$$"
    : > "$tmp_d" || return 1
    while IFS= read -r line; do
        set -- $line
        id="$(safe_id "${1:-}")"
        [ -n "$id" ] || continue
        ts="${2:-}"
        case "$ts" in
            ''|*[!0-9]*) ts="$now" ;;
        esac
        age=$((now - ts))
        if [ "$age" -lt 0 ]; then
            ts="$now"
            age=0
        fi
        [ "$age" -le "$DISMISSED_RETENTION_SEC" ] || continue
        if ! sed -n 's/[[:space:]].*//p' "$tmp_d" | grep -Fqx "$id" 2>/dev/null; then
            printf '%s %s\n' "$id" "$ts" >> "$tmp_d"
        fi
    done < "$DISMISSED_FILE"
    mv "$tmp_d" "$DISMISSED_FILE"
}

extract_num_field() {
    sed -n 's/.*"'"$2"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$1" | sed -n '1p'
}

is_message_valid() {
    f="$1"
    grep -q '"id"[[:space:]]*:' "$f" 2>/dev/null || return 1
    grep -q '"display"[[:space:]]*:' "$f" 2>/dev/null || return 1
    grep -q '"policy"[[:space:]]*:' "$f" 2>/dev/null || return 1
    grep -q '"created"[[:space:]]*:' "$f" 2>/dev/null || return 1
    grep -q '"title"[[:space:]]*:' "$f" 2>/dev/null || grep -q '"body"[[:space:]]*:' "$f" 2>/dev/null || return 1
    case "$(cat "$f" 2>/dev/null)" in
        \{*\}) return 0 ;;
        *) return 1 ;;
    esac
}

rebuild_payload() {
    ensure_base
    guestqr_load_config
    cleanup_dismissed
    now="$(now_epoch)"
    tmp="$OUT.$$"
    printf '{"device":"chronobell","now":%s,"messages":[' "$now" > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    first=1
    for f in "$MSG_DIR"/*.json; do
        [ -f "$f" ] || continue
        exp="$(extract_num_field "$f" expires)"
        if [ -n "$exp" ] && [ "$exp" -le "$now" ]; then
            rm -f "$f"
            continue
        fi
        if ! is_message_valid "$f"; then
            continue
        fi
        id="$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
        if [ -n "$id" ] && is_dismissed "$id"; then
            continue
        fi
        [ "$first" -eq 0 ] && printf ',' >> "$tmp"
        cat "$f" >> "$tmp"
        first=0
    done
    printf ']}\n' >> "$tmp"
    mv "$tmp" "$OUT"
}

serve_payload() {
    cgi="${1:-false}"
    ensure_base
    mode=""
    CHRONOSERVE_REQUEST_DATA="$(request_data)"
    if [ "$cgi" = true ]; then
        first_param="${QUERY_STRING%%&*}"
        first_param="${first_param%%=*}"
        case "$(url_decode "$first_param")" in
            msg) mode=msg ;;
            wifi) mode=wifi ;;
            add|clear|dismiss|undismiss|dismissed|guestqr|check-domain) mode=control ;;
        esac
    fi
    if [ -z "$mode" ]; then
        if [ "$cgi" = true ]; then
            printf 'Status: 400 Bad Request\r\n'
            printf 'Content-Type: text/plain\r\n'
            printf 'Cache-Control: no-store\r\n'
            printf '\r\n'
            printf 'usage: ?msg, ?wifi, ?add, ?clear, ?dismiss, ?undismiss, ?dismissed, ?guestqr, or ?check-domain\n'
        else
            printf 'usage: ?msg or ?wifi\n'
        fi
        return 0
    fi
    if [ "$mode" = control ]; then
        serve_control
        return $?
    fi
    if [ "$mode" = msg ]; then
        dismiss_id="$(query_param_value dismiss)"
        if [ -n "$dismiss_id" ]; then
            dismiss_id="$(safe_id "$dismiss_id")"
            cleanup_dismissed
            if [ -n "$dismiss_id" ] && ! is_dismissed "$dismiss_id"; then
                printf '%s %s\n' "$dismiss_id" "$(now_epoch)" >> "$DISMISSED_FILE"
            fi
        fi
        rebuild_payload >/dev/null 2>&1 || write_message_payload
    else
        write_wifi_payload
    fi
    if [ "$cgi" = true ]; then
        printf 'Content-Type: application/json\r\n'
        printf 'Cache-Control: no-store\r\n'
        printf '\r\n'
    fi
    if [ -f "$OUT" ]; then
        cat "$OUT"
    else
        if [ "$mode" = msg ]; then
            now="$(now_epoch)"
            printf '{"device":"chronobell","now":%s,"messages":[]}\n' "$now"
        else
            now="$(now_epoch)"
            printf '{"device":"chronobell","now":%s,"guestwifi":{"ssid":"","password":""}}\n' "$now"
        fi
    fi
}

control_response() {
    status="${1:-200 OK}"
    ok="$2"
    action="$3"
    message="${4:-}"
    printf 'Status: %s\r\n' "$status"
    printf 'Content-Type: application/json\r\n'
    printf 'Cache-Control: no-store\r\n'
    printf '\r\n'
    if [ "$ok" = true ]; then
        printf '{"ok":true,"action":"%s"' "$(json_escape "$action")"
        [ -n "$message" ] && printf ',"message":"%s"' "$(json_escape "$message")"
        printf '}\n'
    else
        printf '{"ok":false,"action":"%s","error":"%s"}\n' "$(json_escape "$action")" "$(json_escape "$message")"
    fi
}

run_control_command() {
    action="$1"
    shift
    tmp="$BASE/control-output.$$"
    "$@" > "$tmp" 2>&1
    rc=$?
    output="$(sed -n '1p' "$tmp" 2>/dev/null)"
    rm -f "$tmp"
    if [ "$rc" -eq 0 ]; then
        control_response "200 OK" true "$action" "$output"
    elif [ "$rc" -eq 2 ]; then
        control_response "400 Bad Request" false "$action" "$output"
    else
        control_response "500 Internal Server Error" false "$action" "$output"
    fi
}

control_dismissed_response() {
    ensure_base
    printf 'Status: 200 OK\r\n'
    printf 'Content-Type: application/json\r\n'
    printf 'Cache-Control: no-store\r\n'
    printf '\r\n'
    printf '{"ok":true,"action":"dismissed","dismissed":['
    first=1
    cleanup_dismissed
    if [ -f "$DISMISSED_FILE" ]; then
        while IFS= read -r id; do
            set -- $id
            id="${1:-}"
            [ -n "$id" ] || continue
            [ "$first" -eq 0 ] && printf ','
            printf '"%s"' "$(json_escape "$id")"
            first=0
        done < "$DISMISSED_FILE"
    fi
    printf ']}\n'
}

serve_control() {
    first_param="${QUERY_STRING%%&*}"
    action="$(url_decode "${first_param%%=*}")"
    case "$action" in
        add)
            set --
            for name in id source type priority title body detail ttl policy repeat size bell; do
                value="$(query_param_value "$name")"
                if [ -n "$value" ]; then
                    set -- "$@" "--$name" "$value"
                fi
            done
            run_control_command add add_message "$@"
            ;;
        clear)
            if query_param_present all && [ "$(bool_value "$(query_param_value all)")" = true ]; then
                run_control_command clear clear_message --all
            else
                id="$(query_param_value id)"
                [ -n "$id" ] || { control_response "400 Bad Request" false clear "id required"; return 0; }
                run_control_command clear clear_message "$id"
            fi
            ;;
        dismiss)
            id="$(query_param_value id)"
            [ -n "$id" ] || { control_response "400 Bad Request" false dismiss "id required"; return 0; }
            run_control_command dismiss dismiss_message "$id"
            ;;
        undismiss)
            id="$(query_param_value id)"
            [ -n "$id" ] || { control_response "400 Bad Request" false undismiss "id required"; return 0; }
            run_control_command undismiss undismiss_message "$id"
            ;;
        dismissed)
            control_dismissed_response
            ;;
        guestqr)
            set --
            for name in rotate seed ssid section length alphabet outdir; do
                value="$(query_param_value "$name")"
                [ -n "$value" ] && set -- "$@" "--$name" "$value"
            done
            if query_param_present no-apply && [ "$(bool_value "$(query_param_value no-apply)")" = true ]; then
                set -- "$@" --no-apply
            fi
            if query_param_present no-html && [ "$(bool_value "$(query_param_value no-html)")" = true ]; then
                set -- "$@" --no-html
            fi
            run_control_command guestqr guestqr_run "$@"
            ;;
        check-domain)
            domain="$(query_param_value domain)"
            [ -n "$domain" ] || { control_response "400 Bad Request" false check-domain "domain required"; return 0; }
            set -- "$domain"
            id="$(query_param_value id)"
            [ -n "$id" ] && set -- "$@" --id "$id"
            if query_param_present force && [ "$(bool_value "$(query_param_value force)")" = true ]; then
                set -- "$@" --force
            fi
            run_control_command check-domain check_domain "$@"
            ;;
        *)
            control_response "400 Bad Request" false "$action" "unknown action"
            ;;
    esac
}

add_message() {
    id=""
    source="manual"
    type="alert"
    priority=5
    title=""
    body=""
    detail=""
    ttl=600
    policy=temporary
    repeat=0
    size=medium
    bell=

    while [ "$#" -gt 0 ]; do
        case "$1" in
            -i|--inbox)
                policy=inbox
                shift ;;
            -r|--repeat)
                repeat="${2:-0}"
                [ "$policy" = temporary ] && policy=repeat
                shift 2 ;;
            --id) id="${2:-}"; shift 2 ;;
            --source) source="${2:-}"; shift 2 ;;
            --type) type="${2:-}"; shift 2 ;;
            --priority) priority="${2:-}"; shift 2 ;;
            --title) title="${2:-}"; shift 2 ;;
            --body) body="${2:-}"; shift 2 ;;
            --detail) detail="${2:-}"; shift 2 ;;
            --ttl) ttl="${2:-}"; shift 2 ;;
            --forever) ttl=forever; shift ;;
            --policy) policy="$(policy_value "${2:-temporary}")"; shift 2 ;;
            --size) size="$(size_value "${2:-medium}")"; shift 2 ;;
            --small) size=small; shift ;;
            --medium) size=medium; shift ;;
            --big) size=big; shift ;;
            --bell) bell="${2:-}"; shift 2 ;;
            --*) printf 'Unknown option: %s\n' "$1" >&2; return 2 ;;
            *)
                if [ -z "$title" ]; then
                    title="$1"
                elif [ -z "$body" ]; then
                    body="$1"
                else
                    body="$body $1"
                fi
                shift
                ;;
        esac
    done

    [ -n "$title$body" ] || {
        printf 'title or body required\n' >&2
        return 2
    }

    priority="$(num_value "$priority" 5)"
    policy="$(policy_value "$policy")"
    repeat="$(num_value "$repeat" 0)"
    size="$(size_value "$size")"
    case "$ttl" in
        0|forever|FOREVER|never|NEVER) ttl=forever ;;
        *) ttl="$(num_value "$ttl" 600)" ;;
    esac
    now="$(now_epoch)"
    if [ "$ttl" = forever ]; then
        expires=""
    else
        expires=$((now + ttl))
    fi
    if [ -z "$id" ]; then
        slug="$(safe_id "$(printf '%s-%s' "$title" "$now")")"
        id="${slug:-chronoserve-$now}"
    fi
    id="$(safe_id "$id")"
    [ -n "$id" ] || {
        printf 'invalid id\n' >&2
        return 2
    }

    ensure_base
    file="$(message_file_for_id "$id")"
    old_revision="$(extract_num_field "$file" revision 2>/dev/null || true)"
    old_revision="$(num_value "$old_revision" 0)"
    revision=$((old_revision + 1))
    [ "$revision" -gt 0 ] || revision="$now"
    tmp="$file.$$"
    {
        printf '{'
        printf '"id":"%s",' "$(json_escape "$id")"
        printf '"source":"%s",' "$(json_escape "$source")"
        printf '"type":"%s",' "$(json_escape "$type")"
        printf '"revision":%s,' "$revision"
        printf '"priority":%s,' "$priority"
        printf '"title":"%s",' "$(json_escape "$title")"
        printf '"body":"%s",' "$(json_escape "$body")"
        [ -n "$detail" ] && printf '"detail":"%s",' "$(json_escape "$detail")"
        printf '"created":%s,' "$now"
        [ -n "$expires" ] && printf '"expires":%s,' "$expires"
        printf '"policy":{'
        printf '"kind":"%s",' "$policy"
        if [ "$policy" = inbox ]; then
            printf '"indicator":true,"dismissible":true'
        else
            printf '"indicator":false,"dismissible":false'
        fi
        [ "$repeat" -gt 0 ] && printf ',"repeatSec":%s' "$repeat"
        printf '},'
        printf '"display":{'
        printf '"size":"%s",' "$size"
        if [ -n "$bell" ]; then
            printf '"bell":[%s]' "$bell"
        else
            printf '"bell":[]'
        fi
        printf '}}'
    } > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    mv "$tmp" "$file"
    rebuild_payload
}

clear_message() {
    if [ "$1" = --all ]; then
        ensure_base
        rm -f "$MSG_DIR"/*.json
        rebuild_payload
        printf 'all messages cleared\n'
        return 0
    fi
    [ "$#" -eq 1 ] || {
        printf 'Usage: chronoserve clear <id>  or  chronoserve clear --all\n' >&2
        return 2
    }
    ensure_base
    id="$(safe_id "$1")"
    rm -f "$(message_file_for_id "$id")"
    rebuild_payload
}

dismiss_message() {
    id="${1:-}"
    [ -z "$id" ] && { printf 'Usage: chronoserve dismiss <id>\n' >&2; return 2; }
    ensure_base
    id="$(safe_id "$id")"
    [ -z "$id" ] && { printf 'Invalid id\n' >&2; return 2; }
    cleanup_dismissed
    if is_dismissed "$id"; then
        printf 'already dismissed: %s\n' "$id"
        return 0
    fi
    printf '%s %s\n' "$id" "$(now_epoch)" >> "$DISMISSED_FILE"
    rebuild_payload
    printf 'dismissed: %s\n' "$id"
}

undismiss_message() {
    id="${1:-}"
    [ -z "$id" ] && { printf 'Usage: chronoserve undismiss <id>\n' >&2; return 2; }
    ensure_base
    id="$(safe_id "$id")"
    [ -z "$id" ] && { printf 'Invalid id\n' >&2; return 2; }
    tmp="$BASE/undismiss.$$"
    while IFS= read -r line; do
        set -- $line
        [ "${1:-}" = "$id" ] && continue
        [ -n "${1:-}" ] && printf '%s\n' "$line"
    done < "$DISMISSED_FILE" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$DISMISSED_FILE"
    rebuild_payload
    printf 'undismissed: %s\n' "$id"
}

list_dismissed() {
    ensure_base
    cleanup_dismissed
    if [ -f "$DISMISSED_FILE" ] && [ -s "$DISMISSED_FILE" ]; then
        while IFS= read -r line; do
            set -- $line
            id="${1:-}"
            [ -n "$id" ] && printf '%s\n' "$id"
        done < "$DISMISSED_FILE"
    else
        printf 'no dismissed messages\n'
    fi
}

list_messages() {
    rebuild_payload >/dev/null 2>&1 || true
    ensure_base
    show_all=false
    [ "${1:-}" = "--all" ] && show_all=true
    found=0
    for f in "$MSG_DIR"/*.json; do
        [ -f "$f" ] || continue
        id="$(sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
        if [ -n "$id" ] && is_dismissed "$id"; then
            [ "$show_all" = true ] || continue
            marker="[x] "
        else
            marker=""
        fi
        found=1
        title="$(sed -n 's/.*"title"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
        body="$(sed -n 's/.*"body"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
        policy="$(sed -n 's/.*"kind"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
        size="$(sed -n 's/.*"size"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$f" | sed -n '1p')"
        exp="$(extract_num_field "$f" expires)"
        name="${f##*/}"
        name="${name%.json}"
        printf '%s%s policy=%s size=%s priority=%s expires=%s title="%s" body="%s"\n' \
            "$marker" "${id:-$name}" \
            "${policy:-unknown}" "${size:-medium}" \
            "$(extract_num_field "$f" priority)" \
            "${exp:-unknown}" "$title" "$body"
    done
    [ "$found" -eq 1 ] || printf 'no active messages\n'
}

read_state() {
    if [ -f "$1" ]; then
        sed -n '1p' "$1"
    else
        printf 'UNKNOWN\n'
    fi
}

write_state() {
    ensure_base
    printf '%s\n' "$2" > "$1"
}

lock_age() {
    now="$(now_epoch)"
    ts="$(sed -n '1p' "$1" 2>/dev/null)"
    case "$ts" in
        ''|*[!0-9]*) printf '%s\n' "$LOCK_STALE_SEC" ;;
        *) printf '%s\n' $((now - ts)) ;;
    esac
}

acquire_lock() {
    ensure_base
    if [ -f "$1" ]; then
        age="$(lock_age "$1")"
        if [ "$age" -lt "$LOCK_STALE_SEC" ]; then
            return 1
        fi
        rm -f "$1"
    fi
    now_epoch > "$1"
    return 0
}

release_lock() {
    rm -f "$1"
}

have_cmd() {
    command -v "$1" >/dev/null 2>&1
}

interpret_whois_file() {
    body="$1"
    # ---------- EPP status lines ----------
    # Collect normalised status tokens from "Domain Status:" / "Status:" lines,
    # lowercase, strip non-alpha so both "pendingDelete" and "pending delete" work.
    statuses=$(sed -n 's/^[[:space:]]*[Dd]omain[[:space:]][Ss]tatus[[:space:]]*:[[:space:]]*//p
                s/^[[:space:]]*[Ss]tatus[[:space:]]*:[[:space:]]*//p' "$body" \
               | sed 's/[[:space:]].*//; s/[^A-Za-z]//g' | tr 'A-Z' 'a-z')
    if [ -n "$statuses" ]; then
        # Precedence: worst first.
        if printf '%s\n' "$statuses" | grep -qx 'redemptionperiod'; then printf 'REDEMPTION\n'; return; fi
        if printf '%s\n' "$statuses" | grep -qx 'pendingdelete'; then printf 'PENDING_DELETE\n'; return; fi
        if printf '%s\n' "$statuses" | grep -qx 'pendingrestore'; then printf 'PENDING_RESTORE\n'; return; fi
        if printf '%s\n' "$statuses" | grep -Eqx '(server|client)hold'; then printf 'HOLD\n'; return; fi
        if printf '%s\n' "$statuses" | grep -qx 'pendingtransfer'; then printf 'PENDING_TRANSFER\n'; return; fi
        if printf '%s\n' "$statuses" | grep -Eqx 'ok|inactive|addperiod|autorenewperiod|renewperiod|transferperiod|pendingcreate|pendingrenew|pendingupdate|(server|client)(delete|renew|transfer|update)prohibited'; then
            printf 'REGISTERED\n'; return
        fi
        # Status lines present but unrecognised -> safe fallback to CHECK alert.
        printf 'AMBIGUOUS\n'; return
    fi
    # ---------- Free-text fallbacks (for whois without EPP lines) ----------
    if grep -Eqi 'redemptionPeriod|REACTIVATION PERIOD' "$body"; then printf 'REDEMPTION\n'; return; fi
    if grep -Eqi 'pendingDelete' "$body"; then printf 'PENDING_DELETE\n'; return; fi
    if grep -Eqi 'clientTransferProhibited|Registry Domain ID:|Domain Name:|Registrar:|Creation Date:|Registry Expiry Date:|Registrar Registration Expiration Date:|Name Server:' "$body"; then
        printf 'REGISTERED\n'; return
    fi
    if grep -Eqi 'No match|NOT FOUND|No Data Found|No entries found' "$body"; then printf 'AVAILABLE\n'; return; fi
    printf 'AMBIGUOUS\n'
}

check_whois() {
    domain="$1"
    have_cmd whois || return 1
    body="$BASE/whois.$$"
    rm -f "$body"
    whois "$domain" > "$body" 2>/dev/null
    rc=$?
    if [ "$rc" -ne 0 ] || [ ! -s "$body" ]; then
        rm -f "$body"
        printf 'WHOIS ERROR\n'
        return 0
    fi
    state="$(interpret_whois_file "$body")"
    printf 'WHOIS %s\n' "$state"
    rm -f "$body"
}

log_transition() {
    previous="$1"
    state="$2"
    ensure_base
    printf '[%s] Domain state:\n%s\n↓\n%s\n' "$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '?')" "$previous" "$state" >> "$LOG_FILE"
}

remove_domain_messages() {
    suffix="$1"
    rm -f "$(message_file_for_id "domain-state-$suffix")" \
          "$(message_file_for_id "domain-drop-$suffix")" \
          "$(message_file_for_id "domain-registered-$suffix")" \
          "$(message_file_for_id "domain-check-$suffix")" \
          "$(message_file_for_id "domain-redemption-$suffix")" \
          "$(message_file_for_id "domain-error-$suffix")" \
          "$(message_file_for_id "domain-available-$suffix")" \
          "$(message_file_for_id "domain-pending-delete-$suffix")" \
          "$(message_file_for_id "domain-restoring-$suffix")" \
          "$(message_file_for_id "domain-hold-$suffix")" \
          "$(message_file_for_id "domain-transfer-$suffix")"
}

# Remove this domain's dismissed entries so a new (or re-appearing) status
# always surfaces, even if a previous status message was dismissed.
undismiss_domain_messages() {
    suffix="$1"
    [ -f "$DISMISSED_FILE" ] || return 0
    tmp="$BASE/undismiss-domain.$$"
    while IFS= read -r line; do
        set -- $line
        id="${1:-}"
        case "$id" in
            domain-*"-$suffix") continue ;;
        esac
        [ -n "$id" ] && printf '%s\n' "$line"
    done < "$DISMISSED_FILE" > "$tmp" 2>/dev/null || true
    mv "$tmp" "$DISMISSED_FILE"
}

publish_domain_status() {
    suffix="$1"
    state="$2"
    domainpart="$3"
    priority="$4"
    body="$5"
    detail="$6"
    add_message \
        --id "domain-$state-$suffix" \
        --source domain-watch \
        --type alert \
        --inbox \
        --repeat 900 \
        --priority "$priority" \
        --title "$domainpart" \
        --body "$body" \
        --forever \
        --detail "$detail" >/dev/null
}

check_domain() {
    domain=""
    suffix=""
    force=false
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --id) suffix="$(safe_id "${2:-}")"; shift 2 ;;
            --force) force=true; shift ;;
            --*) printf 'Unknown option: %s\n' "$1" >&2; return 2 ;;
            *)
                [ -z "$domain" ] && domain="$1" || { printf 'Unexpected argument: %s\n' "$1" >&2; return 2; }
                shift ;;
        esac
    done
    [ -z "$domain" ] && { printf 'Usage: chronoserve check-domain <domain> [--id suffix] [--force]\n' >&2; return 2; }
    domain="$(printf '%s' "$domain" | tr 'A-Z' 'a-z')"
    [ -n "$suffix" ] || suffix="$(domain_suffix "$domain")"
    [ -n "$suffix" ] || suffix=domain
    domainpart="$(printf '%s' "$domain" | sed 's/\..*//' | tr 'a-z' 'A-Z')"

    lock_file="$(lock_file_for_suffix "$suffix")"
    state_file="$(state_file_for_suffix "$suffix")"

    acquire_lock "$lock_file" || return 0
    trap 'release_lock "$lock_file"' EXIT HUP INT TERM
    result=""
    if result="$(check_whois "$domain")"; then
        method="${result%% *}"
        state="${result#* }"
    else
        method=WHOIS
        state=ERROR
    fi

    previous="$(read_state "$state_file")"

    if [ "$state" = "$previous" ] && [ "$force" != true ]; then
        release_lock "$lock_file"
        trap - EXIT HUP INT TERM
        return 0
    fi

    log_transition "$previous" "$state"
    write_state "$state_file" "$state"
    remove_domain_messages "$suffix"
    undismiss_domain_messages "$suffix"

    case "$state" in
        REDEMPTION)
            publish_domain_status "$suffix" redemption "$domainpart" 5 "REDEMPTION" \
                "Domain can still be restored by the previous owner."
            ;;
        PENDING_DELETE)
            publish_domain_status "$suffix" pending-delete "$domainpart" 7 "PENDING DELETE" \
                "Deletion scheduled. Watch closely."
            ;;
        PENDING_RESTORE)
            publish_domain_status "$suffix" restoring "$domainpart" 6 "RESTORING" \
                "Previous owner is restoring the domain. Drop unlikely."
            ;;
        HOLD)
            publish_domain_status "$suffix" hold "$domainpart" 6 "HOLD" \
                "Domain is on hold and not resolving in DNS."
            ;;
        PENDING_TRANSFER)
            publish_domain_status "$suffix" transfer "$domainpart" 5 "TRANSFER" \
                "Registrar transfer in progress."
            ;;
        AVAILABLE)
            publish_domain_status "$suffix" available "$domainpart" 9 "BUY NOW" \
                "Domain is available for registration."
            ;;
        AMBIGUOUS)
            publish_domain_status "$suffix" check "$domainpart" 6 "CHECK" ""
            ;;
        REGISTERED)
            ;;
        ERROR|UNKNOWN)
            ;;
        *)
            write_state "$state_file" AMBIGUOUS
            [ "$force" = true ] && publish_domain_status "$suffix" check "$domainpart" 6 "CHECK" ""
            ;;
    esac
    release_lock "$lock_file"
    trap - EXIT HUP INT TERM
}

test_domain() {
    domain="$1"
    [ -z "$domain" ] && { printf 'Usage: chronoserve test-domain <domain>\n' >&2; return 2; }
    suffix="$(domain_suffix "$domain")"
    domain="$(printf '%s' "$domain" | tr 'A-Z' 'a-z')"

    printf 'Testing: %s\n' "$domain"
    printf -- '─────────────────────────────────\n'

    state=ERROR
    method=""
    wbody="$BASE/whois-test.$$"

    printf 'WHOIS:\n'
    if have_cmd whois; then
        whois "$domain" > "$wbody" 2>/dev/null
        if [ -s "$wbody" ]; then
            printf '   Response:\n'
            head -c 300 "$wbody" | sed 's/^/   /'
            printf '\n'
            state="$(interpret_whois_file "$wbody")"
            method=WHOIS
            printf '   → interpret_whois_file → %s\n' "$state"
        else
            printf '   Empty response\n'
        fi
    else
        printf '   No whois command available\n'
    fi

    rm -f "$wbody"

    printf -- '─────────────────────────────────\n'
    printf 'Source:     %s\n' "${method:-NONE}"
    printf 'Result:     %s\n' "$state"
    case "$state" in
        REDEMPTION)
            printf 'Message:    domain-redemption-%s\n' "$suffix"
            printf 'Display:    "DOMAIN" / "REDEMPTION"\n'
            printf 'Policy:     inbox (recall via center tap, hold center to dismiss)\n'
            printf 'Priority:   5\n'
            printf 'Detail:     Domain can still be restored by the previous owner.\n'
            ;;
        PENDING_DELETE)
            printf 'Message:    domain-pending-delete-%s\n' "$suffix"
            printf 'Display:    "DOMAIN" / "PENDING DELETE"\n'
            printf 'Policy:     inbox (recall via center tap, hold center to dismiss)\n'
            printf 'Priority:   7\n'
            printf 'Detail:     Deletion scheduled. Watch closely.\n'
            ;;
        PENDING_RESTORE)
            printf 'Message:    domain-restoring-%s\n' "$suffix"
            printf 'Display:    "DOMAIN" / "RESTORING"\n'
            printf 'Policy:     inbox (recall via center tap, hold center to dismiss)\n'
            printf 'Priority:   6\n'
            printf 'Detail:     Previous owner is restoring the domain.\n'
            ;;
        HOLD)
            printf 'Message:    domain-hold-%s\n' "$suffix"
            printf 'Display:    "DOMAIN" / "HOLD"\n'
            printf 'Policy:     inbox (recall via center tap, hold center to dismiss)\n'
            printf 'Priority:   6\n'
            printf 'Detail:     Domain is on hold and not resolving in DNS.\n'
            ;;
        PENDING_TRANSFER)
            printf 'Message:    domain-transfer-%s\n' "$suffix"
            printf 'Display:    "DOMAIN" / "TRANSFER"\n'
            printf 'Policy:     inbox (recall via center tap, hold center to dismiss)\n'
            printf 'Priority:   5\n'
            printf 'Detail:     Registrar transfer in progress.\n'
            ;;
        AVAILABLE)
            printf 'Message:    domain-available-%s\n' "$suffix"
            printf 'Display:    "DOMAIN" / "BUY NOW"\n'
            printf 'Policy:     inbox (recall via center tap, hold center to dismiss)\n'
            printf 'Priority:   9\n'
            ;;
        REGISTERED)
            printf 'Action:     no message (silent)\n'
            printf 'Priority:   -\n'
            ;;
        AMBIGUOUS)
            printf 'Message:    domain-check-%s\n' "$suffix"
            printf 'Display:    "DOMAIN" / "CHECK"\n'
            printf 'Policy:     inbox (recall via center tap, hold center to dismiss)\n'
            printf 'Priority:   6\n'
            ;;
        ERROR)
            printf 'Action:     no message (log only)\n'
            printf 'Priority:   -\n'
            ;;
    esac
    printf -- '─────────────────────────────────\n'
}

# ===== Guest QR =====

guestqr_period_key() {
    case "${1:-weekly}" in
        daily)   date +%Y-%j ;;
        weekly)  date +%G-W%V ;;
        monthly) date +%Y-%m ;;
        yearly)  date +%Y ;;
    esac
}

guestqr_derive_password() {
    seed="$1"
    key="$2"
    len="${3:-12}"
    alphabet="${4:-ABCDEFGHJKLNPQRTUVXYZ}"
    alpha_len=$(printf '%s' "$alphabet" | wc -c | tr -d ' ')
    hash=$(printf '%s' "${seed}${key}" | md5sum | tr -d ' \n-' | cut -c1-32)
    pass="" i=1
    while [ "$(printf '%s' "$pass" | wc -c)" -lt "$len" ]; do
        pair=$(printf '%s' "$hash" | cut -c${i}-$((i+1)))
        val=$(( 0x$pair ))
        idx=$(( val % alpha_len + 1 ))
        char=$(printf '%s' "$alphabet" | cut -c${idx})
        pass="${pass}${char}"
        i=$((i + 2))
        if [ $((i + 1)) -gt 32 ]; then
            hash=$(printf '%s' "${hash}${seed}${key}" | md5sum | tr -d ' \n-' | cut -c1-32)
            i=1
        fi
    done
    printf '%s' "$pass"
}

guestqr_valid_until() {
    mode="${1:-weekly}"
    case "$mode" in
        daily)
            _today=$(date +%Y-%m-%d)
            date -d "$_today 23:59:59" +%s
            ;;
        weekly)
            _dow=$(date +%u)
            _now=$(date +%s)
            _days_left=$(( 7 - _dow ))
            _sun_date=$(date -d "@$(( _now + _days_left * 86400 ))" +%Y-%m-%d)
            date -d "$_sun_date 23:59:59" +%s
            ;;
        monthly)
            _m=$(( $(date +%m) + 0 ))
            _y=$(date +%Y)
            if [ "$_m" -eq 12 ]; then _ny=$(( _y + 1 )); _nm=1
            else _ny=$_y; _nm=$(( _m + 1 )); fi
            printf '%s\n' "$(( $(date -d "$(printf '%s-%02d-01 00:00:00' "$_ny" "$_nm")" +%s) - 1 ))"
            ;;
        yearly)
            _y=$(date +%Y)
            printf '%s\n' "$(( $(date -d "$(printf '%s-01-01 00:00:00' "$(( _y + 1 ))")" +%s) - 1 ))"
            ;;
    esac
}

guestqr_run() {
    rotate=weekly
    seed=""
    ssid="$GQR_SSID"
    section="$GQR_SECTION"
    length="$GQR_LENGTH"
    alphabet="$GQR_ALPHABET"
    outdir="$GQR_OUTDIR"
    no_apply=false
    no_html=false

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --rotate) rotate="${2:-weekly}"; shift 2 ;;
            --seed) seed="$2"; shift 2 ;;
            --ssid) ssid="$2"; shift 2 ;;
            --section) section="$2"; shift 2 ;;
            --length) length="${2:-12}"; shift 2 ;;
            --alphabet) alphabet="$2"; shift 2 ;;
            --outdir) outdir="$2"; shift 2 ;;
            --no-apply) no_apply=true; shift ;;
            --no-html) no_html=true; shift ;;
            *) printf 'Unknown guestqr option: %s\n' "$1" >&2; return 2 ;;
        esac
    done

    [ -z "$seed" ] && seed=$(tr -dc 'a-z0-9' < /dev/urandom | head -c 24 2>/dev/null || printf 'chronoserve-default-seed')
    ensure_base
    guestqr_save_config
    guestqr_save_seed "$seed"

    gqr_lock="$BASE/guestqr.lock"
    if [ -f "$gqr_lock" ]; then
        now=$(now_epoch)
        ts=$(sed -n '1p' "$gqr_lock" 2>/dev/null)
        case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
        age=$(( now - ts ))
        if [ "$age" -lt "$LOCK_STALE_SEC" ]; then
            return 0
        fi
        rm -f "$gqr_lock"
    fi
    now_epoch > "$gqr_lock"
    trap 'rm -f "$gqr_lock"' EXIT HUP INT TERM

    state_file="$GQR_STATE"
    key=$(guestqr_period_key "$rotate")
    stamp="$(guestqr_state_stamp)"
    stored_key="$(sed -n '1p' "$state_file" 2>/dev/null || echo '')"
    stored_stamp="$(sed -n '2p' "$state_file" 2>/dev/null || echo '')"

    if [ "$stored_key" = "$key" ] && [ "$stored_stamp" = "$stamp" ]; then
        rm -f "$gqr_lock"
        trap - EXIT HUP INT TERM
        return 0
    fi

    password=$(guestqr_derive_password "$seed" "$key" "$length" "$alphabet")
    [ -z "$password" ] && return 1

    if [ "$no_apply" = false ]; then
        uci set wireless."$section".key="$password" 2>/dev/null || true
        uci commit wireless 2>/dev/null || true
        wifi reload 2>/dev/null || wifi 2>/dev/null || true
    fi

    mkdir -p "$outdir"
    if [ "$no_html" = false ]; then
        display_pass=$(printf '%s' "$password" | sed 's/.\{4\}/& /g;s/ $//')
        qrdata="WIFI:T:WPA;S:${ssid};P:${password};;"
        if have_cmd qrencode; then
            qrencode -t SVG -o "$outdir/guestwifi.svg" "$qrdata" 2>/dev/null || true
        fi
        case "$rotate" in
            daily)   valid_txt="Valid until midnight" ;;
            weekly)  _dow=$(date +%u); _days_left=$(( 7 - _dow ))
                     valid_txt="Valid until Sunday $(LC_TIME=C date -d "@$(( $(date +%s) + _days_left * 86400 ))" '+%B %-d, %Y' 2>/dev/null || echo 'end of week')" ;;
            monthly) valid_txt="Valid until end of $(LC_TIME=C date '+%B %Y')" ;;
            yearly)  valid_txt="Valid until end of $(date +%Y)" ;;
        esac
        cat > "$outdir/index.html" <<PAGE
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${ssid}</title>
<style>
body {
  margin: 0;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #111;
  font-family: sans-serif;
}

.wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.ssid {
  font-weight: 700;
  white-space: nowrap;
  margin-bottom: 3px;
}

.qr {
  width: 100%;
  display: block;
}

.password {
  font-weight: 700;
  letter-spacing: 0.08em;
  white-space: nowrap;
  margin-top: 3px;
}

.valid {
  color: #888;
  white-space: nowrap;
  margin-top: 2px;
}
</style>
</head>
<body>
  <div class="wrap">
    <div class="ssid">${ssid}</div>
    <img class="qr" src="guestwifi.svg?$(date +%s)" alt="WiFi QR code">
    <div class="password">${display_pass}</div>
    <div class="valid">${valid_txt}</div>
  </div>
  <script>
    function fitText(el, maxW, maxPx) {
      var prev = el.style.display;
      el.style.display = 'inline';
      var lo = 1, hi = maxPx || 500;
      while (lo < hi) {
        var mid = (lo + hi + 1) >> 1;
        el.style.fontSize = mid + 'px';
        if (el.offsetWidth <= maxW) lo = mid; else hi = mid - 1;
      }
      el.style.fontSize = lo + 'px';
      el.style.display = prev;
    }
    function applyFit(w) {
      var wrap = document.querySelector('.wrap');
      wrap.style.width = w + 'px';
      fitText(document.querySelector('.ssid'), w);
      var pw = document.querySelector('.password');
      fitText(pw, w);
      fitText(document.querySelector('.valid'), w, Math.round(parseFloat(pw.style.fontSize) * 0.65));
    }
    function resizeAll() {
      var maxW = window.innerWidth  * 0.98;
      var maxH = window.innerHeight * 0.98;
      var lo = 50, hi = maxW;
      while (hi - lo > 1) {
        var mid = (lo + hi) / 2;
        applyFit(mid);
        if (document.querySelector('.wrap').offsetHeight <= maxH) lo = mid; else hi = mid - 1;
      }
      applyFit(lo);
    }
    var img = document.querySelector('.qr');
    function init() { document.fonts.ready.then(resizeAll); }
    if (img.complete) { init(); } else { img.addEventListener('load', init); }
    window.addEventListener('resize', resizeAll);
    setTimeout(function() { location.reload(); }, 5 * 60 * 1000);
  </script>
</body>
</html>
PAGE
        cp "$outdir/index.html" "$outdir/gl_home.html" 2>/dev/null || true
        chmod 644 "$outdir/guestwifi.svg" "$outdir/index.html" "$outdir/gl_home.html" 2>/dev/null || true
    fi

    printf '%s\n%s\n' "$key" "$stamp" > "$state_file"
    chmod 600 "$state_file" 2>/dev/null || true
    rm -f "$gqr_lock"
    trap - EXIT HUP INT TERM
}

# ===== Cron management =====

reload_cron() {
    [ "${CHRONOSERVE_NO_CRON_RELOAD:-0}" = 1 ] && return 0
    if [ -x /etc/init.d/cron ]; then
        /etc/init.d/cron restart >/dev/null 2>&1 || /etc/init.d/cron reload >/dev/null 2>&1 || true
    fi
}

cron_list() {
    if [ -f "$CRON_FILE" ]; then
        grep "/usr/bin/chronoserve" "$CRON_FILE" || printf 'no chronoserve cron entries\n'
    else
        printf 'no chronoserve cron entries\n'
    fi
}

cron_add() {
    feature="${1:-}"
    shift 2>/dev/null || true
    [ -z "$feature" ] && { printf 'Usage: chronoserve cron add check-domain <domain>|guestqr [--hour H] [--minute M] [--weekday N]\n' >&2; return 2; }
    ensure_base
    mkdir -p "$(dirname "$CRON_FILE")" 2>/dev/null || true
    line=""
    case "$feature" in
        check-domain)
            domain="${1:-}"
            [ -z "$domain" ] && { printf 'Usage: chronoserve cron add check-domain <domain>\n' >&2; return 2; }
            line="0 * * * * /usr/bin/chronoserve check-domain $domain >/dev/null 2>&1"
            ;;
        guestqr)
            hour=3; minute=0; weekday="*"
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --hour) hour="${2:-3}"; shift 2 ;;
                    --minute) minute="${2:-0}"; shift 2 ;;
                    --weekday) weekday="${2:-*}"; shift 2 ;;
                    *) shift ;;
                esac
            done
            line="$minute $hour * * $weekday /usr/bin/chronoserve guestqr >/dev/null 2>&1"
            ;;
        *)
            printf 'Unknown cron feature: %s\n' "$feature" >&2
            return 2
            ;;
    esac
    if [ -f "$CRON_FILE" ] && grep -Fqx "$line" "$CRON_FILE" 2>/dev/null; then
        printf 'already installed: %s\n' "$line"
        return 0
    fi
    printf '%s\n' "$line" >> "$CRON_FILE"
    reload_cron
    printf 'installed cron: %s\n' "$line"
}

cron_remove() {
    feature="${1:-}"
    [ -z "$feature" ] && { printf 'Usage: chronoserve cron remove check-domain|guestqr\n' >&2; return 2; }
    ensure_base
    tmp="$BASE/crontab.$$"
    if [ -f "$CRON_FILE" ]; then
        grep -v "/usr/bin/chronoserve $feature " "$CRON_FILE" > "$tmp" 2>/dev/null || true
        mv "$tmp" "$CRON_FILE"
    fi
    reload_cron
    printf 'removed %s cron entries\n' "$feature"
}

cron_uninstall() {
    ensure_base
    tmp="$BASE/crontab.$$"
    if [ -f "$CRON_FILE" ]; then
        grep -v "/usr/bin/chronoserve" "$CRON_FILE" > "$tmp" 2>/dev/null || true
        mv "$tmp" "$CRON_FILE"
    fi
    reload_cron
    printf 'removed all chronoserve cron entries\n'
}

chronoserve_install() {
    cgi_dir="${1:-/www/cgi-bin}"
    self="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
    target="/usr/bin/chronoserve"

    if [ "$self" != "$target" ]; then
        printf 'copy chronoserve to %s first:\n  scp %s root@<router>:%s\n' "$target" "$self" "$target" >&2
        return 1
    fi

    printf 'chronoserve: creating state directory %s...\n' "$BASE"
    ensure_base

    printf 'chronoserve: setting executable bit on %s...\n' "$target"
    [ -x "$target" ] || chmod +x "$target"

    printf 'chronoserve: creating CGI directory %s...\n' "$cgi_dir"
    mkdir -p "$cgi_dir"

    printf 'chronoserve: writing CGI wrapper %s/chronoserve...\n' "$cgi_dir"
    cat > "$cgi_dir/chronoserve" <<'CGIEOF'
#!/bin/sh
exec /usr/bin/chronoserve serve --cgi
CGIEOF
    chmod +x "$cgi_dir/chronoserve"

    printf 'chronoserve: installed\n'
    printf '  binary:  %s\n' "$target"
    printf '  cgi:     %s/chronoserve\n' "$cgi_dir"
    printf '  state:   %s\n' "$BASE"
}

chronoserve_uninstall() {
    cgi_dir="${1:-/www/cgi-bin}"

    if [ -f "$cgi_dir/chronoserve" ]; then
        printf 'chronoserve: removing CGI wrapper %s/chronoserve...\n' "$cgi_dir"
        rm -f "$cgi_dir/chronoserve"
        rmdir "$cgi_dir" 2>/dev/null || true
    else
        printf 'chronoserve: no CGI wrapper at %s/chronoserve\n' "$cgi_dir"
    fi

    printf 'chronoserve: removing cron entries...\n'
    cron_uninstall

    printf 'chronoserve: state directory preserved: %s\n' "$BASE"
    printf 'chronoserve: remove manually: rm -rf %s\n' "$BASE"
}

usage() {
    cat <<'EOF'
Usage:
  chronoserve serve [--cgi]
  chronoserve add [options] TITLE BODY
  chronoserve clear ID
  chronoserve list [--all]
  chronoserve rebuild
  chronoserve dismiss ID
  chronoserve undismiss ID
  chronoserve dismissed
  chronoserve check-domain <domain> [--id suffix] [--force]
   chronoserve test-domain <domain>
   chronoserve guestqr [options]

Domain watcher states (published as inbox messages on transition):
  AVAILABLE(9)/BUY NOW  PENDING_DELETE(7)/PENDING DELETE  RESTORING(6)  HOLD(6)
  REDEMPTION(5)  TRANSFER(5)  CHECK(6)   Silent: REGISTERED ERROR UNKNOWN
  Recall via center tap, dismiss with center hold.
   chronoserve cron list|add|remove|uninstall
  chronoserve install [/www/cgi-bin]
  chronoserve uninstall [/www/cgi-bin]
  chronoserve help

Add options:
  -i, --inbox         Keep in message view until dismissed
  -r, --repeat SEC   Repeat preview at interval (combine with --inbox for re-previewing inbox messages)
  --id ID              Message identifier (auto-generated if omitted)
  --source SOURCE      Source label (default: manual)
  --type TYPE          Message type (default: alert)
  --priority N         Priority 0-9 (default: 5)
  --ttl SEC|forever    Time-to-live seconds, 0/forever never expires (default: 600)
  --forever            Never expire
  --title TITLE        Override displayed title
  --body BODY          Override displayed body
  --detail TEXT        Internal detail (not shown on clock)
  --small|--medium|--big  Font size (default: medium)
  --bell COUNT|PATTERN  Bell strikes: 3 or "3,2,1" (default: no bell)

Guestqr options:
  --rotate MODE        Rotation period: daily, weekly, monthly, yearly
  --seed TEXT          Deterministic seed (auto-generated if omitted)
  --ssid NAME          WiFi SSID (default: NEXO-GUEST)
  --section ID         UCI wireless section (default: guest2g)
  --length N           Password length (default: 12)
  --alphabet CHARS     Password character set
  --outdir PATH        Output directory (default: /www/qr)
  --no-apply           Skip uci wireless update
  --no-html            Skip HTML/QR file generation

Cron commands:
  cron list            List active chronoserve cron entries
  cron add check-domain <domain>             Hourly domain check
  cron add guestqr [--hour H] [--minute M] [--weekday N]   Guest QR rotation (default: daily)
  cron remove check-domain|guestqr           Remove cron entries by feature
  cron uninstall                             Remove all chronoserve cron entries
EOF
}

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift

case "$cmd" in
    serve)
        cgi=false
        [ "${REQUEST_METHOD:-}${GATEWAY_INTERFACE:-}${SCRIPT_NAME:-}" != "" ] && cgi=true
        if [ "${1:-}" = "--cgi" ]; then
            cgi=true
            shift
        fi
        [ "$#" -eq 0 ] || {
            printf 'Unexpected serve argument\n' >&2
            exit 2
        }
        serve_payload "$cgi"
        ;;
    add)
        add_message "$@"
        ;;
    clear|remove)
        clear_message "$@"
        ;;
    list)
        list_messages "$@"
        ;;
    dismiss)
        dismiss_message "$@"
        ;;
    undismiss)
        undismiss_message "$@"
        ;;
    dismissed)
        list_dismissed
        ;;
    rebuild)
        rebuild_payload
        ;;
    check-domain)
        check_domain "$@"
        ;;
    test-domain)
        test_domain "$@"
        ;;
    guestqr)
        guestqr_run "$@"
        ;;
    cron)
        subcmd="${1:-help}"
        shift 2>/dev/null || true
        case "$subcmd" in
            list) cron_list ;;
            add) cron_add "$@" ;;
            remove) cron_remove "$@" ;;
            uninstall) cron_uninstall ;;
            *) printf 'Usage: chronoserve cron list|add|remove|uninstall\n' >&2; exit 2 ;;
        esac
        ;;
    install)
        chronoserve_install "$@"
        ;;
    uninstall)
        chronoserve_uninstall "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
